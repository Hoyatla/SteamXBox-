<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Le contrat des plugins et la lecture de leurs fichiers, sans interface ni registre.

    Cible net10.0 et non net10.0-windows, comme SteamXBox.Calculator et pour la meme raison : c'est
    de la logique pure, et cette separation est ce qui permet au projet de tests de la referencer.
    L'ecriture dans Windows vit dans SteamXBox.Shell, ou elle ne peut pas etre testee ; tout ce qui
    peut etre decide avant d'y toucher est decide ici.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>SteamXBox.Plugins</RootNamespace>
    <Product>SteamXBox</Product>
    <AssemblyTitle>SteamXBox Plugins</AssemblyTitle>
    <Description>SteamXBox - contrat et chargement des plugins.</Description>
  </PropertyGroup>

</Project>
