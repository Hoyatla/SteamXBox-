<Window x:Class="SenSÉ.EditeurTexte.UI.FenetreRecherche"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Rechercher" Height="180" Width="520"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        FocusManager.FocusedElement="{Binding ElementName=ChampRecherche}">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="100"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Text="Rechercher :" VerticalAlignment="Center"/>
        <TextBox   Grid.Row="0" Grid.Column="1" x:Name="ChampRecherche" Margin="0,0,0,4"/>

        <TextBlock Grid.Row="1" Grid.Column="0" Text="Remplacer par :" VerticalAlignment="Center"
                   x:Name="LabelRemplacer"/>
        <TextBox   Grid.Row="1" Grid.Column="1" x:Name="ChampRemplacer" Margin="0,0,0,4"/>

        <CheckBox  Grid.Row="2" Grid.Column="1" x:Name="ChkCasse" Content="Sensible à la casse"
                   Margin="0,4,0,4"/>

        <StackPanel Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2"
                    Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="BtnPrecedent"        Content="Précédent"   Width="84" Height="26" Margin="0,0,4,0"/>
            <Button x:Name="BtnSuivant"          Content="Suivant"     Width="84" Height="26" Margin="0,0,4,0" IsDefault="True"/>
            <Button x:Name="BtnRemplacerUn"      Content="Remplacer"   Width="84" Height="26" Margin="0,0,4,0"/>
            <Button x:Name="BtnToutRemplacer"    Content="Tout rempl." Width="92" Height="26" Margin="0,0,4,0"/>
            <Button x:Name="BtnFermer"           Content="Fermer"      Width="84" Height="26" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
