  <ItemGroup>
    <ProjectReference Include="..\SenSÉ.Mcp.Bus\SenSÉ.Mcp.Bus.csproj" />
    <PackageReference Include="System.Drawing.Common" Version="8.0.0" />
  </ItemGroup>

</Project>