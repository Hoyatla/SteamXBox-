<Window x:Class="SteamXBox.Gui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:SteamXBox.Gui.Localization"
        xmlns:vm="clr-namespace:SteamXBox.Gui.ViewModels"
        xmlns:views="clr-namespace:SteamXBox.Gui.Views"
        Title="SteamXBox" Width="900" Height="620"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgDarkBrush}"
        WindowStyle="None" AllowsTransparency="True"
        ResizeMode="CanResizeWithGrip"
        >

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="32"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Title bar -->
        <Grid Grid.Row="0" Background="{StaticResource BgMediumBrush}"
              MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <TextBlock Text="{loc:T Text='SteamXBox'}" VerticalAlignment="Center" Margin="12,0,0,0"
                       FontSize="12" FontWeight="SemiBold"
                       Foreground="{StaticResource TextSecondaryBrush}"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="─" Click="Minimize_Click" Width="46" Height="32"
                        FontSize="13" Background="Transparent" Foreground="{StaticResource TextSecondaryBrush}"
                        BorderThickness="0" />
                <Button Content="□" Click="Maximize_Click" Width="46" Height="32"
                        FontSize="13" Background="Transparent" Foreground="{StaticResource TextSecondaryBrush}"
                        BorderThickness="0" />
                <Button Content="✕" Click="Close_Click" Width="46" Height="32"
                        FontSize="13" Background="Transparent" Foreground="{StaticResource TextSecondaryBrush}"
                        BorderThickness="0" >
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="Transparent"/>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="{StaticResource AccentRedBrush}"/>
                                    <Setter Property="Foreground" Value="White"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource NavRail}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Bottom" Margin="16,0,16,16">
                        <!-- Juste au-dessus des encarts d'état, aligné à droite du rail. -->
                        <Button Style="{StaticResource DiscordButton}" Click="Discord_Click"
                                Margin="0,0,0,6"
                                ToolTip="{loc:T Text='Rejoindre le Discord'}"/>

                        <Border Style="{StaticResource StatusCard}">
                            <StackPanel>
                                <TextBlock Text="{loc:T Text='Status'}" FontSize="10" Foreground="{StaticResource TextDimBrush}"
                                           FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding StatusText}" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{Binding IsCoreRunning, Converter={x:Static views:StatusToColorConverter.Instance}}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource StatusCard}" Margin="0,6,0,0">
                            <StackPanel>
                                <TextBlock Text="{loc:T Text='Device'}" FontSize="10" Foreground="{StaticResource TextDimBrush}"
                                           FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding DeviceName}" FontSize="11"
                                           Foreground="{Binding IsDeviceConnected, Converter={x:Static views:StatusToColorConverter.Instance}}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- RadioButtons, not Buttons: the group gives the active tab a real checked
                         state, which a theme can render and a skin can retemplate freely. -->
                    <StackPanel Margin="16,16" x:Name="NavPanel">
                        <RadioButton Content="{loc:T Text='🏠  Accueil'}" Tag="0" Click="Nav_Click"
                                     GroupName="Nav" IsChecked="True" Style="{StaticResource NavButton}"/>
                        <RadioButton Content="{loc:T Text='📋  Profils'}" Tag="1" Click="Nav_Click"
                                     GroupName="Nav" Style="{StaticResource NavButton}"/>
                        <RadioButton Content="{loc:T Text='🎮  Xbox'}" Tag="2" Click="Nav_Click"
                                     GroupName="Nav" Style="{StaticResource NavButton}"/>
                        <RadioButton Content="{loc:T Text='⚙  Paramètres'}" Tag="3" Click="Nav_Click"
                                     GroupName="Nav" Style="{StaticResource NavButton}"/>
                        <RadioButton Content="{loc:T Text='📄  Logs'}" Tag="4" Click="Nav_Click"
                                     GroupName="Nav" Style="{StaticResource NavButton}"/>
                        <RadioButton Content="{loc:T Text='🔧  Debug'}" Tag="5" Click="Nav_Click"
                                     GroupName="Nav" Style="{StaticResource NavButton}"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <Grid Grid.Column="1">
                <views:HomeView x:Name="HomeView" Margin="24"/>
                <views:ProfileView x:Name="ProfileView" Margin="24" Visibility="Collapsed"/>
                <views:XboxView x:Name="XboxView" Margin="24" Visibility="Collapsed"/>
                <views:SettingsView x:Name="SettingsView" Margin="24" Visibility="Collapsed"/>
                <views:LogView x:Name="LogView" Margin="24" Visibility="Collapsed"/>
                <views:DebugView x:Name="DebugView" Margin="24" Visibility="Collapsed"/>
            </Grid>
        </Grid>
    </Grid>

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="6"
                      GlassFrameThickness="0" CornerRadius="0"/>
    </WindowChrome.WindowChrome>
</Window>
