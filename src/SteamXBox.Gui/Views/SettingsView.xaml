<UserControl x:Class="SteamXBox.Gui.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:SteamXBox.Gui.ViewModels">

    <StackPanel>
        <TextBlock Text="Paramètres" Style="{StaticResource HeaderText}" Margin="0,0,0,20"/>

        <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="Pilotes" FontSize="16" FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,12"/>

                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="ViGEmBus" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                        <TextBlock Text="{Binding VigEmStatus}" FontSize="12"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                    </StackPanel>
                    <Button Grid.Column="1" Content="Recharger" Command="{Binding CheckDriverStatusCommand}"
                            Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Padding="12,6"/>
                    <Button Grid.Column="2" Content="Télécharger" Command="{Binding OpenViGEmDownloadCommand}"
                            Style="{StaticResource SecondaryButton}" Padding="12,6"/>
                </Grid>

                <Separator Background="{StaticResource BorderBrush}" Margin="0,0,0,12"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="HidHide" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                        <TextBlock Text="{Binding HidHideStatus}" FontSize="12"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                    </StackPanel>
                    <Button Grid.Column="1" Content="Recharger" Command="{Binding CheckDriverStatusCommand}"
                            Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Padding="12,6"/>
                    <Button Grid.Column="2" Content="Télécharger" Command="{Binding OpenHidHideDownloadCommand}"
                            Style="{StaticResource SecondaryButton}" Padding="12,6"/>
                </Grid>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="Comportement" FontSize="16" FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,12"/>

                <CheckBox Content="Démarrer automatiquement au lancement"
                          IsChecked="{Binding AutoStart}"
                          Style="{StaticResource ToggleSwitch}"/>

                <CheckBox Content="Minimiser dans la barre des tâches"
                          IsChecked="{Binding MinimizeToTray}"
                          Style="{StaticResource ToggleSwitch}"/>

                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="100"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Intervalle de détection device (secondes)" FontSize="13"
                               Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                    <TextBox Grid.Column="1" Style="{StaticResource TextBoxDark}"
                             Text="{Binding DevicePollInterval, UpdateSourceTrigger=PropertyChanged}"
                             HorizontalContentAlignment="Center"/>
                </Grid>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource CardBorder}">
            <StackPanel>
                <TextBlock Text="À propos" FontSize="16" FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,12"/>
                <TextBlock Text="SteamXBox v2.3" FontSize="14"
                           Foreground="{StaticResource TextPrimaryBrush}"/>
                <TextBlock Text="Steam Controller → Xbox 360 Virtual Gamepad Bridge"
                           FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                <TextBlock Text="github.com/Hoyatla/SteamXBox-" FontSize="12"
                           Foreground="{StaticResource AccentBrush}" Margin="0,4,0,0"
                           Cursor="Hand">
                    <TextBlock.InputBindings>
                        <MouseBinding MouseAction="LeftClick"
                                      Command="{Binding DataContext.OpenUrlCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                      CommandParameter="https://github.com/Hoyatla/SteamXBox-"/>
                    </TextBlock.InputBindings>
                </TextBlock>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
