<UserControl x:Class="SteamXBox.Gui.Views.ProfileView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:SteamXBox.Gui.Localization"
             xmlns:vm="clr-namespace:SteamXBox.Gui.ViewModels"
             xmlns:Converters="clr-namespace:SteamXBox.Gui.Converters">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <Converters:InvertedBoolToVisibilityConverter x:Key="InvertedBoolToVis"/>
        <Style x:Key="ProfileListItemStyle" TargetType="ListBoxItem">
            <Setter Property="Background" Value="{StaticResource BgLightBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border CornerRadius="6" Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}" Margin="{TemplateBinding Margin}"
                                BorderThickness="{TemplateBinding BorderThickness}" Cursor="{TemplateBinding Cursor}">
                            <ContentPresenter/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
                </Trigger>
                <DataTrigger Binding="{Binding Name}" Value="Default">
                    <Setter Property="Background" Value="#FF222233"/>
                </DataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding Name}" Value="Default"/>
                        <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource Self}}" Value="True"/>
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left: profile list -->
        <StackPanel Grid.Column="0" Margin="0,0,16,0">
            <TextBlock Text="{loc:T Text='Profils'}" Style="{StaticResource HeaderText}" Margin="0,0,0,12"/>

            <ListBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfileItem}"
                     ItemContainerStyle="{StaticResource ProfileListItemStyle}"
                     Background="Transparent" BorderThickness="0" FocusVisualStyle="{x:Null}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Margin="0,0,6,0" FontSize="13"
                                       Text="{loc:T Text='🔒'}" Visibility="Collapsed">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Name}" Value="Default">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Grid.Column="1" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       Text="{Binding Name}"/>
                            <TextBlock Grid.Column="2" Text="{Binding Mode}" FontSize="11"
                                       Foreground="{StaticResource TextDimBrush}"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <Separator Background="{StaticResource BorderBrush}" Margin="0,12"/>

            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <TextBox Style="{StaticResource TextBoxDark}" Width="150"
                         Text="{Binding NewProfileName, UpdateSourceTrigger=PropertyChanged}"
                         VerticalContentAlignment="Center"/>
                <Button Content="+" Command="{Binding CreateNewProfileCommand}"
                        Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" Padding="12,8"/>
            </StackPanel>

            <TextBlock Text="{Binding StatusMessage}" FontSize="11"
                       Foreground="{StaticResource AccentOrangeBrush}" Margin="0,4,0,0"
                       TextWrapping="Wrap"/>
        </StackPanel>

        <!-- Right: placeholder when nothing selected -->
        <Border Grid.Column="1" Style="{StaticResource CardBorder}"
                Visibility="{Binding IsEditing, Converter={StaticResource InvertedBoolToVis}}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="{loc:T Text='Sélectionnez un profil pour l\'éditer'}"
                           Foreground="{StaticResource TextDimBrush}" FontSize="14"
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- Right: Default read-only card -->
        <Border Grid.Column="1" Style="{StaticResource CardBorder}"
                Visibility="{Binding IsEditingDefault, Converter={StaticResource BoolToVis}}"
                VerticalAlignment="Stretch">
            <Grid Margin="40">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0">
                    <TextBlock Text="{loc:T Text='Profil par défaut'}" FontSize="18" FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center"
                               Margin="0,0,0,8"/>
                    <TextBlock Text="{loc:T Text='Le profil « Default » porte les réglages de référence. Il n\'est pas modifiable, mais peut être restauré.'}"
                               FontSize="13" Foreground="{StaticResource TextSecondaryBrush}"
                               TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,16"/>
                    <Button Content="{loc:T Text='🔄  Restaurer les paramètres par défaut'}" Command="{Binding ResetToFactoryDefaultsCommand}"
                            Style="{StaticResource PrimaryButton}" Padding="16,8" HorizontalAlignment="Center"
                            Margin="0,0,0,16"/>
                    <TextBlock Text="{loc:T Text='Valeurs par défaut'}" FontSize="14" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8"/>
                </StackPanel>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel TextElement.Foreground="{StaticResource TextSecondaryBrush}" TextElement.FontSize="12">
                        <TextBlock Text="{loc:T Text='Mouvements :'}" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <TextBlock Text="{loc:T Text='Pad gauche → Scroll (4.8 crans/unité, dead zone 0.002)'}"/>
                        <TextBlock Text="{loc:T Text='Pad droit → Trackball (380 px/unité, dead zone 0.00015)'}"/>
                        <TextBlock Text="{loc:T Text='Stick gauche → Flèches directionnelles'}"/>
                        <TextBlock Text="{loc:T Text='Inversion : pad gauche Y, pad droit Y'}"/>
                        <TextBlock Text="{loc:T Text='Dead zone stick gauche : 0.06    stick droite : 0.018'}"/>
                        <TextBlock Text=" " Margin="0,8,0,0"/>
                        <TextBlock Text="{loc:T Text='Comportement :'}" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <TextBlock Text="{loc:T Text='Accélération : gauche 1.5, droite 2.0'}"/>
                        <TextBlock Text="{loc:T Text='Inertie : gauche et droite 2.0 (glisse longue)'}"/>
                        <TextBlock Text="{loc:T Text='Précision fine : 0.10    Seuil de lancer : 70 px'}"/>
                        <TextBlock Text="{loc:T Text='Continuation en bord : 750 px/s'}"/>
                        <TextBlock Text=" " Margin="0,8,0,0"/>
                        <TextBlock Text="{loc:T Text='Boutons :'}" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <TextBlock Text="{loc:T Text='L4 → PrintScreen    R4 → Win+G'}"/>
                        <TextBlock Text="{loc:T Text='L5 → Win+R          R5 → Alt+F4'}"/>
                        <TextBlock Text="{loc:T Text='LB → Alt+Tab        RB → Win+Tab'}"/>
                        <TextBlock Text="{loc:T Text='A → OSK Toggle      B → OSK Toggle'}"/>
                        <TextBlock Text="{loc:T Text='X → Alt+←           Y → Alt+→'}"/>
                        <TextBlock Text="{loc:T Text='L3 → Enter          R3 → Aucun'}"/>
                        <TextBlock Text="{loc:T Text='Menu → Win          View → Win+D'}"/>
                        <TextBlock Text="{loc:T Text='DPad ↑ → Volume+    DPad ↓ → Volume-'}"/>
                        <TextBlock Text="{loc:T Text='DPad ← → Back       DPad → → Forward'}"/>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- Right: editor panel -->
        <ScrollViewer Grid.Column="1"
                      Visibility="{Binding IsEditing, Converter={StaticResource BoolToVis}}"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="4,0,0,0"
                        Visibility="{Binding IsEditingDefault, Converter={StaticResource InvertedBoolToVis}}">

                <!-- Action buttons row -->
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Content="{loc:T Text='Sauvegarder'}" Command="{Binding SaveProfileCommand}"
                            Style="{StaticResource PrimaryButton}" Margin="0,0,4,0" Height="36" FontSize="13"/>
                    <Button Grid.Column="1" Content="{loc:T Text='Appliquer'}" Command="{Binding ApplyProfileCommand}"
                            Style="{StaticResource SecondaryButton}" Margin="4,0" Height="36" FontSize="13"/>
                    <Button Grid.Column="2" Content="{loc:T Text='Supprimer'}" Command="{Binding DeleteActiveProfileCommand}"
                            CommandParameter="{Binding ActiveEdit}"
                            Style="{StaticResource DangerButton}" Margin="4,0,0,0" Height="36" FontSize="13"/>
                </Grid>

                <!-- The "Paramètres généraux" card lived here and held only a Profile/Xbox360 mode
                     picker, which duplicated what the tabs already express. Removed rather than
                     reworked: the stored value is still used when launching the core. -->

                <!-- Overlay Keyboard -->
                <Border Style="{StaticResource CardBorder}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="{loc:T Text='Overlay Keyboard'}" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,4"/>
                        <TextBlock Text="{loc:T Text='Ces réglages s\'appliquent au clavier virtuel, pas au bureau Windows.'}"
                                   FontSize="11" Foreground="{StaticResource TextDimBrush}" Margin="0,0,0,12"
                                   TextWrapping="Wrap"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="{loc:T Text='Mode de saisie'}" VerticalAlignment="Center"
                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                            <ComboBox Grid.Row="0" Grid.Column="1" Style="{StaticResource ComboBoxDark}" Margin="0,4,12,4"
                                      ItemsSource="{Binding OskTypingModes}"
                                      ItemTemplate="{StaticResource OptionDisplayItem}"
                                      SelectedValuePath="Value"
                                      SelectedValue="{Binding OskMode}"/>

                            <TextBlock Grid.Row="0" Grid.Column="2" Text="{loc:T Text='Intensité vibrations'}" VerticalAlignment="Center"
                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                            <DockPanel Grid.Row="0" Grid.Column="3" Margin="0,4,0,4">
                                <TextBlock DockPanel.Dock="Right" Style="{StaticResource SliderValueText}"
                                           Text="{Binding OskHapticIntensityDisplay}"/>
                                <Slider Style="{StaticResource SliderCompact}" Value="{Binding OskHapticIntensity}"/>
                            </DockPanel>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="{loc:T Text='Force clic pad gauche'}" VerticalAlignment="Center"
                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                            <DockPanel Grid.Row="1" Grid.Column="1" Margin="0,4,12,4">
                                <TextBlock DockPanel.Dock="Right" Style="{StaticResource SliderValueText}"
                                           Text="{Binding OskLeftClickForceDisplay}"/>
                                <Slider Style="{StaticResource SliderCompact}" Value="{Binding OskLeftClickForce}"/>
                            </DockPanel>

                            <TextBlock Grid.Row="1" Grid.Column="2" Text="{loc:T Text='Force clic pad droit'}" VerticalAlignment="Center"
                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                            <DockPanel Grid.Row="1" Grid.Column="3" Margin="0,4,0,4">
                                <TextBlock DockPanel.Dock="Right" Style="{StaticResource SliderValueText}"
                                           Text="{Binding OskRightClickForceDisplay}"/>
                                <Slider Style="{StaticResource SliderCompact}" Value="{Binding OskRightClickForce}"/>
                            </DockPanel>
                        </Grid>

                        <Separator Background="{StaticResource BorderBrush}" Margin="0,12"/>

                        <CheckBox Content="{loc:T Text='Vibrer au survol des touches'}"
                                  IsChecked="{Binding OskHoverHaptics}"
                                  Style="{StaticResource ToggleSwitch}"/>
                        <TextBlock Text="{loc:T Text='Un tic à chaque touche franchie, pour taper sans regarder l\'overlay.'}"
                                   FontSize="11" Foreground="{StaticResource TextDimBrush}" Margin="0,0,0,4"/>

                        <CheckBox Content="{loc:T Text='Valider au relâchement du clic'}"
                                  IsChecked="{Binding OskValidateOnRelease}"
                                  Style="{StaticResource ToggleSwitch}"/>
                        <TextBlock Text="{loc:T Text='Permet de repositionner le doigt en maintenant le clic avant de valider.'}"
                                   FontSize="11" Foreground="{StaticResource TextDimBrush}"/>
                    </StackPanel>
                </Border>

                <!-- Mouvements -->
                <Border Style="{StaticResource CardBorder}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="{loc:T Text='Mouvements'}" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,12"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Left column: left pad and left stick. Right column: right pad and right
                                 stick. Counterparts sit on the same row so they can be compared. -->
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="{loc:T Text='GAUCHE'}" FontWeight="SemiBold" FontSize="11"
                                       Margin="0,0,0,4" Foreground="{StaticResource TextDimBrush}"/>
                            <TextBlock Grid.Row="0" Grid.Column="2" Text="{loc:T Text='DROITE'}" FontWeight="SemiBold" FontSize="11"
                                       Margin="0,0,0,4" Foreground="{StaticResource TextDimBrush}"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="{loc:T Text='Pad gauche'}" VerticalAlignment="Center"
                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                            <ComboBox Grid.Row="1" Grid.Column="1" Style="{StaticResource ComboBoxDark}" Margin="0,4,12,4"
                                      ItemsSource="{Binding LeftPadOptions}" ItemTemplate="{StaticResource LocalizedComboItem}" SelectedItem="{Binding MotionLeftPad}"/>

                            <TextBlock Grid.Row="1" Grid.Column="2" Text="{loc:T Text='Pad droit'}" VerticalAlignment="Center"
                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                            <ComboBox Grid.Row="1" Grid.Column="3" Style="{StaticResource ComboBoxDark}" Margin="0,4,0,4"
                                      ItemsSource="{Binding RightPadOptions}" ItemTemplate="{StaticResource LocalizedComboItem}" SelectedItem="{Binding MotionRightPad}"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="{loc:T Text='Sensibilité pad'}" VerticalAlignment="Center"
                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                            <DockPanel Grid.Row="2" Grid.Column="1" Margin="0,4,12,4">
                                <TextBlock DockPanel.Dock="Right" Style="{StaticResource SliderValueText}"
                                           Text="{Binding LeftPadSensitivityDisplay}"/>
                                <Slider Style="{StaticResource SliderCompact}" Value="{Binding LeftPadSensitivityPercent}"/>
                            </DockPanel>

                            <TextBlock Grid.Row="2" Grid.Column="2" Text="{loc:T Text='Sensibilité pad'}" VerticalAlignment="Center"
                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                            <DockPanel Grid.Row="2" Grid.Column="3" Margin="0,4,0,4">
                                <TextBlock DockPanel.Dock="Right" Style="{StaticResource SliderValueText}"
                                           Text="{Binding RightPadSensitivityDisplay}"/>
                                <Slider Style="{StaticResource SliderCompact}" Value="{Binding RightPadSensitivityPercent}"/>
                            </DockPanel>

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="{loc:T Text='Dead zone pad'}" VerticalAlignment="Center"
                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                            <DockPanel Grid.Row="3" Grid.Column="1" Margin="0,4,12,4">
                                <TextBlock DockPanel.Dock="Right" Style="{StaticResource SliderValueText}"
                                           Text="{Binding LeftPadDeadZoneDisplay}"/>
                                <Slider Style="{StaticResource SliderCompact}" Value="{Binding LeftPadDeadZonePercent}"/>
                            </DockPanel>

                            <TextBlock Grid.Row="3" Grid.Column="2" Text="{loc:T Text='Dead zone pad'}" VerticalAlignment="Center"
                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                            <DockPanel Grid.Row="3" Grid.Column="3" Margin="0,4,0,4">
                                <TextBlock DockPanel.Dock="Right" Style="{StaticResource SliderValueText}"
                                           Text="{Binding RightPadDeadZoneDisplay}"/>
                                <Slider Style="{StaticResource SliderCompact}" Value="{Binding RightPadDeadZonePercent}"/>
                            </DockPanel>

                            <TextBlock Grid.Row="4" Grid.Column="0" Text="{loc:T Text='Inversion pad'}" VerticalAlignment="Center"
                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                            <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal" Margin="0,4,12,4">
                                <CheckBox Content="Y" IsChecked="{Binding ActiveEdit.LeftPadInvertVertical}"
                                          Style="{StaticResource ToggleSwitch}"/>
                            </StackPanel>

                            <TextBlock Grid.Row="4" Grid.Column="2" Text="{loc:T Text='Inversion pad'}" VerticalAlignment="Center"
                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                            <StackPanel Grid.Row="4" Grid.Column="3" Orientation="Horizontal" Margin="0,4,0,4">
                                <CheckBox Content="X" IsChecked="{Binding ActiveEdit.RightPadInvertX}"
                                          Style="{StaticResource ToggleSwitch}" Margin="0,0,10,0"/>
                                <CheckBox Content="Y" IsChecked="{Binding ActiveEdit.RightPadInvertY}"
                                          Style="{StaticResource ToggleSwitch}"/>
                            </StackPanel>

                            <TextBlock Grid.Row="5" Grid.Column="0" Text="{loc:T Text='Stick gauche'}" VerticalAlignment="Center"
                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                            <ComboBox Grid.Row="5" Grid.Column="1" Style="{StaticResource ComboBoxDark}" Margin="0,4,12,4"
                                      ItemsSource="{Binding LeftStickOptions}" ItemTemplate="{StaticResource LocalizedComboItem}" SelectedItem="{Binding MotionLeftStick}"/>

                            <TextBlock Grid.Row="6" Grid.Column="0" Text="{loc:T Text='Dead zone stick'}" VerticalAlignment="Center"
                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                            <DockPanel Grid.Row="6" Grid.Column="1" Margin="0,4,12,4">
                                <TextBlock DockPanel.Dock="Right" Style="{StaticResource SliderValueText}"
                                           Text="{Binding StickDeadZoneDisplay}"/>
                                <Slider Style="{StaticResource SliderCompact}" Value="{Binding StickDeadZonePercent}"/>
                            </DockPanel>

                            <TextBlock Grid.Row="6" Grid.Column="2" Text="{loc:T Text='Dead zone stick'}" VerticalAlignment="Center"
                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                            <DockPanel Grid.Row="6" Grid.Column="3" Margin="0,4,0,4">
                                <TextBlock DockPanel.Dock="Right" Style="{StaticResource SliderValueText}"
                                           Text="{Binding XboxStickDeadZoneDisplay}"/>
                                <Slider Style="{StaticResource SliderCompact}" Value="{Binding XboxStickDeadZonePercent}"/>
                            </DockPanel>

                        </Grid>

                        <Separator Background="{StaticResource BorderBrush}" Margin="0,12"/>

                        <TextBlock Text="{loc:T Text='Comportement'}" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="{loc:T Text='GAUCHE'}" FontWeight="SemiBold" FontSize="11"
                                       Margin="0,0,0,4" Foreground="{StaticResource TextDimBrush}"/>
                            <TextBlock Grid.Row="0" Grid.Column="2" Text="{loc:T Text='DROITE'}" FontWeight="SemiBold" FontSize="11"
                                       Margin="0,0,0,4" Foreground="{StaticResource TextDimBrush}"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="{loc:T Text='Accélération'}" VerticalAlignment="Center"
                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                            <DockPanel Grid.Row="1" Grid.Column="1" Margin="0,4,12,4">
                                <TextBlock DockPanel.Dock="Right" Style="{StaticResource SliderValueText}"
                                           Text="{Binding LeftPadAccelerationDisplay}"/>
                                <Slider Style="{StaticResource SliderCompact}" Value="{Binding LeftPadAccelerationPercent}"/>
                            </DockPanel>

                            <TextBlock Grid.Row="1" Grid.Column="2" Text="{loc:T Text='Accélération'}" VerticalAlignment="Center"
                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                            <DockPanel Grid.Row="1" Grid.Column="3" Margin="0,4,0,4">
                                <TextBlock DockPanel.Dock="Right" Style="{StaticResource SliderValueText}"
                                           Text="{Binding RightPadAccelerationDisplay}"/>
                                <Slider Style="{StaticResource SliderCompact}" Value="{Binding RightPadAccelerationPercent}"/>
                            </DockPanel>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="{loc:T Text='Inertie'}" VerticalAlignment="Center"
                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                            <DockPanel Grid.Row="2" Grid.Column="1" Margin="0,4,12,4">
                                <TextBlock DockPanel.Dock="Right" Style="{StaticResource SliderValueText}"
                                           Text="{Binding LeftPadInertiaDisplay}"/>
                                <Slider Style="{StaticResource SliderCompact}" Value="{Binding LeftPadInertiaPercent}"/>
                            </DockPanel>

                            <TextBlock Grid.Row="2" Grid.Column="2" Text="{loc:T Text='Inertie'}" VerticalAlignment="Center"
                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                            <DockPanel Grid.Row="2" Grid.Column="3" Margin="0,4,0,4">
                                <TextBlock DockPanel.Dock="Right" Style="{StaticResource SliderValueText}"
                                           Text="{Binding RightPadInertiaDisplay}"/>
                                <Slider Style="{StaticResource SliderCompact}" Value="{Binding RightPadInertiaPercent}"/>
                            </DockPanel>

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="{loc:T Text='Scroll horizontal'}" VerticalAlignment="Center"
                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                            <CheckBox Grid.Row="3" Grid.Column="1" Content="{loc:T Text='Activer'}" Margin="0,4,12,4"
                                      IsChecked="{Binding LeftPadHorizontalScroll}"
                                      Style="{StaticResource ToggleSwitch}"/>

                            <TextBlock Grid.Row="3" Grid.Column="2" Text="{loc:T Text='Précision fine'}" VerticalAlignment="Center"
                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                            <DockPanel Grid.Row="3" Grid.Column="3" Margin="0,4,0,4">
                                <TextBlock DockPanel.Dock="Right" Style="{StaticResource SliderValueText}"
                                           Text="{Binding FinePrecisionDisplay}"/>
                                <Slider Style="{StaticResource SliderCompact}" Value="{Binding FinePrecisionPercent}"/>
                            </DockPanel>

                            <TextBlock Grid.Row="4" Grid.Column="2" Text="{loc:T Text='Continuation en bord'}" VerticalAlignment="Center"
                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                            <DockPanel Grid.Row="4" Grid.Column="3" Margin="0,4,0,4">
                                <TextBlock DockPanel.Dock="Right" Style="{StaticResource SliderValueText}"
                                           Text="{Binding RightPadEdgeSpeedDisplay}"/>
                                <Slider Style="{StaticResource SliderCompact}" Value="{Binding RightPadEdgeSpeedPercent}"/>
                            </DockPanel>

                            <TextBlock Grid.Row="4" Grid.Column="0" Text="{loc:T Text='Seuil de lancer'}" VerticalAlignment="Center"
                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                            <DockPanel Grid.Row="4" Grid.Column="1" Margin="0,4,12,4">
                                <TextBlock DockPanel.Dock="Right" Style="{StaticResource SliderValueText}"
                                           Text="{Binding MinThrowTravelDisplay}"/>
                                <Slider Style="{StaticResource SliderCompact}" Value="{Binding MinThrowTravelPercent}"/>
                            </DockPanel>

                            <TextBlock Grid.Row="5" Grid.Column="0" Text="{loc:T Text='Force vibration'}" VerticalAlignment="Center"
                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                            <DockPanel Grid.Row="5" Grid.Column="1" Margin="0,4,12,4">
                                <TextBlock DockPanel.Dock="Right" Style="{StaticResource SliderValueText}"
                                           Text="{Binding LeftPadHapticForceDisplay}"/>
                                <Slider Style="{StaticResource SliderCompact}" Value="{Binding LeftPadHapticForcePercent}"/>
                            </DockPanel>

                            <TextBlock Grid.Row="5" Grid.Column="2" Text="{loc:T Text='Force vibration'}" VerticalAlignment="Center"
                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                            <DockPanel Grid.Row="5" Grid.Column="3" Margin="0,4,0,4">
                                <TextBlock DockPanel.Dock="Right" Style="{StaticResource SliderValueText}"
                                           Text="{Binding RightPadHapticForceDisplay}"/>
                                <Slider Style="{StaticResource SliderCompact}" Value="{Binding RightPadHapticForcePercent}"/>
                            </DockPanel>

                            <TextBlock Grid.Row="6" Grid.Column="0" Text="{loc:T Text='Fréquence vibration'}" VerticalAlignment="Center"
                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                            <DockPanel Grid.Row="6" Grid.Column="1" Margin="0,4,12,4">
                                <TextBlock DockPanel.Dock="Right" Style="{StaticResource SliderValueText}"
                                           Text="{Binding LeftPadHapticFrequencyDisplay}"/>
                                <Slider Style="{StaticResource SliderCompact}" Value="{Binding LeftPadHapticFrequencyPercent}"/>
                            </DockPanel>

                            <TextBlock Grid.Row="6" Grid.Column="2" Text="{loc:T Text='Fréquence vibration'}" VerticalAlignment="Center"
                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                            <DockPanel Grid.Row="6" Grid.Column="3" Margin="0,4,0,4">
                                <TextBlock DockPanel.Dock="Right" Style="{StaticResource SliderValueText}"
                                           Text="{Binding RightPadHapticFrequencyDisplay}"/>
                                <Slider Style="{StaticResource SliderCompact}" Value="{Binding RightPadHapticFrequencyPercent}"/>
                            </DockPanel>

                        </Grid>

                        <TextBlock Text="{loc:T Text='Précision fine : force de la réduction sur un petit geste. Portée précision : distance sur laquelle elle s\'applique avant de revenir à la normale. Seuil de lancer : en dessous, relâcher ne projette pas le curseur. Anti-frôlement : distance qu\'un nouveau contact doit parcourir avant d\'agir.'}"
                                   FontSize="11" Foreground="{StaticResource TextDimBrush}" Margin="0,8,0,0"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <!-- Boutons -->
                <Border Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock Text="{loc:T Text='Boutons'}" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,12"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="{loc:T Text='L4'}" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                            <ComboBox Grid.Row="0" Grid.Column="1" Style="{StaticResource ComboBoxDark}" Margin="0,4,12,4"
                                      ItemsSource="{Binding RearButtonOptions}" ItemTemplate="{StaticResource LocalizedComboItem}" SelectedItem="{Binding ButtonL4}"/>

                            <TextBlock Grid.Row="0" Grid.Column="2" Text="{loc:T Text='R4'}" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                            <ComboBox Grid.Row="0" Grid.Column="3" Style="{StaticResource ComboBoxDark}" Margin="0,4,0,4"
                                      ItemsSource="{Binding RearButtonOptions}" ItemTemplate="{StaticResource LocalizedComboItem}" SelectedItem="{Binding ButtonR4}"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="{loc:T Text='L5'}" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                            <ComboBox Grid.Row="1" Grid.Column="1" Style="{StaticResource ComboBoxDark}" Margin="0,4,12,4"
                                      ItemsSource="{Binding RearButtonOptions}" ItemTemplate="{StaticResource LocalizedComboItem}" SelectedItem="{Binding ButtonL5}"/>

                            <TextBlock Grid.Row="1" Grid.Column="2" Text="{loc:T Text='R5'}" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                            <ComboBox Grid.Row="1" Grid.Column="3" Style="{StaticResource ComboBoxDark}" Margin="0,4,0,4"
                                      ItemsSource="{Binding RearButtonOptions}" ItemTemplate="{StaticResource LocalizedComboItem}" SelectedItem="{Binding ButtonR5}"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="{loc:T Text='LB'}" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                            <ComboBox Grid.Row="2" Grid.Column="1" Style="{StaticResource ComboBoxDark}" Margin="0,4,12,4"
                                      ItemsSource="{Binding BumperOptions}" ItemTemplate="{StaticResource LocalizedComboItem}" SelectedItem="{Binding ButtonLBumper}"/>

                            <TextBlock Grid.Row="2" Grid.Column="2" Text="{loc:T Text='RB'}" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                            <ComboBox Grid.Row="2" Grid.Column="3" Style="{StaticResource ComboBoxDark}" Margin="0,4,0,4"
                                      ItemsSource="{Binding BumperOptions}" ItemTemplate="{StaticResource LocalizedComboItem}" SelectedItem="{Binding ButtonRBumper}"/>

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="A" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                            <ComboBox Grid.Row="3" Grid.Column="1" Style="{StaticResource ComboBoxDark}" Margin="0,4,12,4"
                                      ItemsSource="{Binding AOptions}" ItemTemplate="{StaticResource LocalizedComboItem}" SelectedItem="{Binding ButtonA}"/>

                            <TextBlock Grid.Row="3" Grid.Column="2" Text="B" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                            <ComboBox Grid.Row="3" Grid.Column="3" Style="{StaticResource ComboBoxDark}" Margin="0,4,0,4"
                                      ItemsSource="{Binding BOptions}" ItemTemplate="{StaticResource LocalizedComboItem}" SelectedItem="{Binding ButtonB}"/>

                            <TextBlock Grid.Row="4" Grid.Column="0" Text="X" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                            <ComboBox Grid.Row="4" Grid.Column="1" Style="{StaticResource ComboBoxDark}" Margin="0,4,12,4"
                                      ItemsSource="{Binding XOptions}" ItemTemplate="{StaticResource LocalizedComboItem}" SelectedItem="{Binding ButtonX}"/>

                            <TextBlock Grid.Row="4" Grid.Column="2" Text="Y" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                            <ComboBox Grid.Row="4" Grid.Column="3" Style="{StaticResource ComboBoxDark}" Margin="0,4,0,4"
                                      ItemsSource="{Binding YOptions}" ItemTemplate="{StaticResource LocalizedComboItem}" SelectedItem="{Binding ButtonY}"/>

                            <TextBlock Grid.Row="5" Grid.Column="0" Text="{loc:T Text='L3 (stick)'}" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                            <ComboBox Grid.Row="5" Grid.Column="1" Style="{StaticResource ComboBoxDark}" Margin="0,4,12,4"
                                      ItemsSource="{Binding L3Options}" ItemTemplate="{StaticResource LocalizedComboItem}" SelectedItem="{Binding ButtonL3}"/>

                            <TextBlock Grid.Row="5" Grid.Column="2" Text="{loc:T Text='R3 (stick)'}" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                            <ComboBox Grid.Row="5" Grid.Column="3" Style="{StaticResource ComboBoxDark}" Margin="0,4,0,4"
                                      ItemsSource="{Binding R3Options}" ItemTemplate="{StaticResource LocalizedComboItem}" SelectedItem="{Binding ButtonR3}"/>

                            <TextBlock Grid.Row="6" Grid.Column="0" Text="{loc:T Text='Menu'}" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                            <ComboBox Grid.Row="6" Grid.Column="1" Style="{StaticResource ComboBoxDark}" Margin="0,4,12,4"
                                      ItemsSource="{Binding MenuOptions}" ItemTemplate="{StaticResource LocalizedComboItem}" SelectedItem="{Binding ButtonMenu}"/>

                            <TextBlock Grid.Row="6" Grid.Column="2" Text="{loc:T Text='View'}" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                            <ComboBox Grid.Row="6" Grid.Column="3" Style="{StaticResource ComboBoxDark}" Margin="0,4,0,4"
                                      ItemsSource="{Binding ViewOptions}" ItemTemplate="{StaticResource LocalizedComboItem}" SelectedItem="{Binding ButtonView}"/>

                            <TextBlock Grid.Row="7" Grid.Column="0" Text="{loc:T Text='DPad ↑'}" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                            <ComboBox Grid.Row="7" Grid.Column="1" Style="{StaticResource ComboBoxDark}" Margin="0,4,12,4"
                                      ItemsSource="{Binding DPadUpOptions}" ItemTemplate="{StaticResource LocalizedComboItem}" SelectedItem="{Binding ButtonDPadUp}"/>

                            <TextBlock Grid.Row="7" Grid.Column="2" Text="{loc:T Text='DPad ↓'}" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                            <ComboBox Grid.Row="7" Grid.Column="3" Style="{StaticResource ComboBoxDark}" Margin="0,4,0,4"
                                      ItemsSource="{Binding DPadDownOptions}" ItemTemplate="{StaticResource LocalizedComboItem}" SelectedItem="{Binding ButtonDPadDown}"/>

                            <TextBlock Grid.Row="8" Grid.Column="0" Text="{loc:T Text='DPad ←'}" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                            <ComboBox Grid.Row="8" Grid.Column="1" Style="{StaticResource ComboBoxDark}" Margin="0,4,12,4"
                                      ItemsSource="{Binding DPadLeftOptions}" ItemTemplate="{StaticResource LocalizedComboItem}" SelectedItem="{Binding ButtonDPadLeft}"/>

                            <TextBlock Grid.Row="8" Grid.Column="2" Text="{loc:T Text='DPad →'}" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                            <ComboBox Grid.Row="8" Grid.Column="3" Style="{StaticResource ComboBoxDark}" Margin="0,4,0,4"
                                      ItemsSource="{Binding DPadRightOptions}" ItemTemplate="{StaticResource LocalizedComboItem}" SelectedItem="{Binding ButtonDPadRight}"/>
                        </Grid>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
