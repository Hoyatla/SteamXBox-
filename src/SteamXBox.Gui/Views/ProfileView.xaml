<UserControl x:Class="SteamXBox.Gui.Views.ProfileView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:SteamXBox.Gui.ViewModels"
             xmlns:Converters="clr-namespace:SteamXBox.Gui.Converters">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <Converters:InvertedBoolToVisibilityConverter x:Key="InvertedBoolToVis"/>
        <Style x:Key="ProfileListItemStyle" TargetType="ListBoxItem">
            <Setter Property="Background" Value="{StaticResource BgLightBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border CornerRadius="6" Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}" Margin="{TemplateBinding Margin}"
                                BorderThickness="{TemplateBinding BorderThickness}" Cursor="{TemplateBinding Cursor}">
                            <ContentPresenter/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
                </Trigger>
                <DataTrigger Binding="{Binding Name}" Value="Default">
                    <Setter Property="Background" Value="#FF222233"/>
                </DataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding Name}" Value="Default"/>
                        <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource Self}}" Value="True"/>
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left: profile list -->
        <StackPanel Grid.Column="0" Margin="0,0,16,0">
            <TextBlock Text="Profils" Style="{StaticResource HeaderText}" Margin="0,0,0,12"/>

            <ListBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfileItem}"
                     ItemContainerStyle="{StaticResource ProfileListItemStyle}"
                     Background="Transparent" BorderThickness="0" FocusVisualStyle="{x:Null}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Margin="0,0,6,0" FontSize="13"
                                       Text="🔒" Visibility="Collapsed">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Name}" Value="Default">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Grid.Column="1" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       Text="{Binding Name}"/>
                            <TextBlock Grid.Column="2" Text="{Binding Mode}" FontSize="11"
                                       Foreground="{StaticResource TextDimBrush}"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <Separator Background="{StaticResource BorderBrush}" Margin="0,12"/>

            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <TextBox Style="{StaticResource TextBoxDark}" Width="150"
                         Text="{Binding NewProfileName, UpdateSourceTrigger=PropertyChanged}"
                         VerticalContentAlignment="Center"/>
                <Button Content="+" Command="{Binding CreateNewProfileCommand}"
                        Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" Padding="12,8"/>
            </StackPanel>

            <TextBlock Text="{Binding StatusMessage}" FontSize="11"
                       Foreground="{StaticResource AccentOrangeBrush}" Margin="0,4,0,0"
                       TextWrapping="Wrap"/>
        </StackPanel>

        <!-- Right: placeholder when nothing selected -->
        <Border Grid.Column="1" Style="{StaticResource CardBorder}"
                Visibility="{Binding IsEditing, Converter={StaticResource InvertedBoolToVis}}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="Sélectionnez un profil pour l'éditer"
                           Foreground="{StaticResource TextDimBrush}" FontSize="14"
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- Right: Default read-only card -->
        <Border Grid.Column="1" Style="{StaticResource CardBorder}"
                Visibility="{Binding IsEditingDefault, Converter={StaticResource BoolToVis}}"
                VerticalAlignment="Stretch">
            <Grid Margin="40">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0">
                    <TextBlock Text="Profil par défaut" FontSize="18" FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center"
                               Margin="0,0,0,8"/>
                    <TextBlock Text="Le profil « Default » est le profil d'usine. Il n'est pas modifiable."
                               FontSize="13" Foreground="{StaticResource TextSecondaryBrush}"
                               TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,16"/>
                    <Button Content="🔄  Restaurer les paramètres d'usine" Command="{Binding ResetToFactoryDefaultsCommand}"
                            Style="{StaticResource SecondaryButton}" Padding="16,8" HorizontalAlignment="Center"
                            Margin="0,0,0,16"/>
                    <TextBlock Text="Valeurs d'usine" FontSize="14" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8"/>
                </StackPanel>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel TextElement.Foreground="{StaticResource TextSecondaryBrush}" TextElement.FontSize="12">
                        <TextBlock Text="Mouvements :" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <TextBlock Text="  Pad droit → Trackball (sensibilité 900 px/unité)"/>
                        <TextBlock Text="  Pad gauche → Scroll (molette 10 px/pas)"/>
                        <TextBlock Text="  Stick gauche → Flèches directionnelles"/>
                        <TextBlock Text="  Inversion Y pad droit : Activée"/>
                        <TextBlock Text="  Inversion X pad droit : Désactivée"/>
                        <TextBlock Text="  Inversion verticale pad gauche : Activée"/>
                        <TextBlock Text="  Dead zone stick : 0.5 (50%)"/>
                        <TextBlock Text="  Dead zone stick Xbox : 0.08 (8%)"/>
                        <TextBlock Text=" " Margin="0,8,0,0"/>
                        <TextBlock Text="Boutons :" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <TextBlock Text="  L4 → PrintScreen    R4 → Win+G"/>
                        <TextBlock Text="  L5 → Win+R          R5 → Alt+F4"/>
                        <TextBlock Text="  LB → Alt+Tab        RB → Win+Tab"/>
                        <TextBlock Text="  A → OSK Toggle      B → OSK Toggle"/>
                        <TextBlock Text="  X → Alt+←           Y → Alt+→"/>
                        <TextBlock Text="  L3 → Enter          R3 → Aucun"/>
                        <TextBlock Text="  Menu → Win          View → Win+D"/>
                        <TextBlock Text="  DPad ↑ → Volume+    DPad ↓ → Volume-"/>
                        <TextBlock Text="  DPad ← → Back       DPad → → Forward"/>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- Right: editor panel -->
        <ScrollViewer Grid.Column="1"
                      Visibility="{Binding IsEditing, Converter={StaticResource BoolToVis}}"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="4,0,0,0"
                        Visibility="{Binding IsEditingDefault, Converter={StaticResource InvertedBoolToVis}}">

                <!-- Action buttons row -->
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Content="Sauvegarder" Command="{Binding SaveProfileCommand}"
                            Style="{StaticResource PrimaryButton}" Margin="0,0,4,0" Height="36" FontSize="13"/>
                    <Button Grid.Column="1" Content="Annuler" Command="{Binding CancelEditCommand}"
                            Style="{StaticResource SecondaryButton}" Margin="4,0" Height="36" FontSize="13"/>
                    <Button Grid.Column="2" Content="Supprimer" Command="{Binding DeleteActiveProfileCommand}"
                            CommandParameter="{Binding ActiveEdit}"
                            Style="{StaticResource DangerButton}" Margin="4,0,0,0" Height="36" FontSize="13"/>
                </Grid>

                <!-- Paramètres généraux -->
                <Border Style="{StaticResource CardBorder}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Paramètres généraux" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,12"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Mode" VerticalAlignment="Center"
                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                            <ComboBox Grid.Row="0" Grid.Column="1" Style="{StaticResource ComboBoxDark}"
                                      ItemsSource="{Binding AvailableModes}" SelectedItem="{Binding ActiveEdit.Mode}" Margin="0,4,12,4"/>

                            <TextBlock Grid.Row="0" Grid.Column="2" Text="Vibrations" VerticalAlignment="Center"
                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                            <StackPanel Grid.Row="0" Grid.Column="3" Orientation="Horizontal" Margin="0,4,12,4">
                                <CheckBox Content="Activer" IsChecked="True" Style="{StaticResource ToggleSwitch}"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Mouvements -->
                <Border Style="{StaticResource CardBorder}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Mouvements" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,12"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Pad droit" VerticalAlignment="Center"
                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                            <ComboBox Grid.Row="0" Grid.Column="1" Style="{StaticResource ComboBoxDark}" Margin="0,4,12,4"
                                      ItemsSource="{Binding RightPadOptions}" SelectedItem="{Binding MotionRightPad}"/>

                            <TextBlock Grid.Row="0" Grid.Column="2" Text="Pad gauche" VerticalAlignment="Center"
                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                            <ComboBox Grid.Row="0" Grid.Column="3" Style="{StaticResource ComboBoxDark}" Margin="0,4,0,4"
                                      ItemsSource="{Binding LeftPadOptions}" SelectedItem="{Binding MotionLeftPad}"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Stick gauche" VerticalAlignment="Center"
                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                            <ComboBox Grid.Row="1" Grid.Column="1" Style="{StaticResource ComboBoxDark}" Margin="0,4,12,4"
                                      ItemsSource="{Binding LeftStickOptions}" SelectedItem="{Binding MotionLeftStick}"/>

                            <TextBlock Grid.Row="1" Grid.Column="2" Text="Sensibilité pad droit" VerticalAlignment="Center"
                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBox Grid.Row="1" Grid.Column="3" Style="{StaticResource TextBoxDark}" Margin="0,4,0,4"
                                     Text="{Binding ActiveEdit.RightPadSensitivity, UpdateSourceTrigger=PropertyChanged}"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Sensibilité pad gauche" VerticalAlignment="Center"
                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBox Grid.Row="2" Grid.Column="1" Style="{StaticResource TextBoxDark}" Margin="0,4,12,4"
                                     Text="{Binding ActiveEdit.LeftPadSensitivity, UpdateSourceTrigger=PropertyChanged}"/>

                            <TextBlock Grid.Row="2" Grid.Column="2" Text="Dead zone stick gauche" VerticalAlignment="Center"
                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBox Grid.Row="2" Grid.Column="3" Style="{StaticResource TextBoxDark}" Margin="0,4,0,4"
                                     Text="{Binding ActiveEdit.StickDeadZone, UpdateSourceTrigger=PropertyChanged}"/>

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Dead zone stick droite" VerticalAlignment="Center"
                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBox Grid.Row="3" Grid.Column="1" Style="{StaticResource TextBoxDark}" Margin="0,4,12,4"
                                     Text="{Binding ActiveEdit.XboxStickDeadZone, UpdateSourceTrigger=PropertyChanged}"/>

                            <TextBlock Grid.Row="3" Grid.Column="2" Text="Dead zone pad droit" VerticalAlignment="Center"
                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBox Grid.Row="3" Grid.Column="3" Style="{StaticResource TextBoxDark}" Margin="0,4,0,4"
                                     Text="{Binding ActiveEdit.RightPadDeadZone, UpdateSourceTrigger=PropertyChanged}"/>

                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Dead zone pad gauche" VerticalAlignment="Center"
                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBox Grid.Row="4" Grid.Column="1" Style="{StaticResource TextBoxDark}" Margin="0,4,12,4"
                                     Text="{Binding ActiveEdit.LeftPadDeadZone, UpdateSourceTrigger=PropertyChanged}"/>

                            <TextBlock Grid.Row="4" Grid.Column="2" Text="Inversion" VerticalAlignment="Center"
                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                            <StackPanel Grid.Row="4" Grid.Column="3" Orientation="Horizontal" Margin="0,4,0,4">
                                <CheckBox Content="Pad droit X" IsChecked="{Binding ActiveEdit.RightPadInvertX}"
                                          Style="{StaticResource ToggleSwitch}" Margin="0,0,8,0"/>
                                <CheckBox Content="Pad droit Y" IsChecked="{Binding ActiveEdit.RightPadInvertY}"
                                          Style="{StaticResource ToggleSwitch}" Margin="0,0,8,0"/>
                                <CheckBox Content="Pad gauche Y" IsChecked="{Binding ActiveEdit.LeftPadInvertVertical}"
                                          Style="{StaticResource ToggleSwitch}"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Boutons -->
                <Border Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock Text="Boutons" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,12"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="L4" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                            <ComboBox Grid.Row="0" Grid.Column="1" Style="{StaticResource ComboBoxDark}" Margin="0,4,12,4"
                                      ItemsSource="{Binding RearButtonOptions}" SelectedItem="{Binding ButtonL4}"/>

                            <TextBlock Grid.Row="0" Grid.Column="2" Text="R4" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                            <ComboBox Grid.Row="0" Grid.Column="3" Style="{StaticResource ComboBoxDark}" Margin="0,4,0,4"
                                      ItemsSource="{Binding RearButtonOptions}" SelectedItem="{Binding ButtonR4}"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="L5" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                            <ComboBox Grid.Row="1" Grid.Column="1" Style="{StaticResource ComboBoxDark}" Margin="0,4,12,4"
                                      ItemsSource="{Binding RearButtonOptions}" SelectedItem="{Binding ButtonL5}"/>

                            <TextBlock Grid.Row="1" Grid.Column="2" Text="R5" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                            <ComboBox Grid.Row="1" Grid.Column="3" Style="{StaticResource ComboBoxDark}" Margin="0,4,0,4"
                                      ItemsSource="{Binding RearButtonOptions}" SelectedItem="{Binding ButtonR5}"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="LB" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                            <ComboBox Grid.Row="2" Grid.Column="1" Style="{StaticResource ComboBoxDark}" Margin="0,4,12,4"
                                      ItemsSource="{Binding BumperOptions}" SelectedItem="{Binding ButtonLBumper}"/>

                            <TextBlock Grid.Row="2" Grid.Column="2" Text="RB" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                            <ComboBox Grid.Row="2" Grid.Column="3" Style="{StaticResource ComboBoxDark}" Margin="0,4,0,4"
                                      ItemsSource="{Binding BumperOptions}" SelectedItem="{Binding ButtonRBumper}"/>

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="A" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                            <ComboBox Grid.Row="3" Grid.Column="1" Style="{StaticResource ComboBoxDark}" Margin="0,4,12,4"
                                      ItemsSource="{Binding AOptions}" SelectedItem="{Binding ButtonA}"/>

                            <TextBlock Grid.Row="3" Grid.Column="2" Text="B" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                            <ComboBox Grid.Row="3" Grid.Column="3" Style="{StaticResource ComboBoxDark}" Margin="0,4,0,4"
                                      ItemsSource="{Binding BOptions}" SelectedItem="{Binding ButtonB}"/>

                            <TextBlock Grid.Row="4" Grid.Column="0" Text="X" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                            <ComboBox Grid.Row="4" Grid.Column="1" Style="{StaticResource ComboBoxDark}" Margin="0,4,12,4"
                                      ItemsSource="{Binding XOptions}" SelectedItem="{Binding ButtonX}"/>

                            <TextBlock Grid.Row="4" Grid.Column="2" Text="Y" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                            <ComboBox Grid.Row="4" Grid.Column="3" Style="{StaticResource ComboBoxDark}" Margin="0,4,0,4"
                                      ItemsSource="{Binding YOptions}" SelectedItem="{Binding ButtonY}"/>

                            <TextBlock Grid.Row="5" Grid.Column="0" Text="L3 (stick)" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                            <ComboBox Grid.Row="5" Grid.Column="1" Style="{StaticResource ComboBoxDark}" Margin="0,4,12,4"
                                      ItemsSource="{Binding L3Options}" SelectedItem="{Binding ButtonL3}"/>

                            <TextBlock Grid.Row="5" Grid.Column="2" Text="R3 (stick)" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                            <ComboBox Grid.Row="5" Grid.Column="3" Style="{StaticResource ComboBoxDark}" Margin="0,4,0,4"
                                      ItemsSource="{Binding R3Options}" SelectedItem="{Binding ButtonR3}"/>

                            <TextBlock Grid.Row="6" Grid.Column="0" Text="Menu" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                            <ComboBox Grid.Row="6" Grid.Column="1" Style="{StaticResource ComboBoxDark}" Margin="0,4,12,4"
                                      ItemsSource="{Binding MenuOptions}" SelectedItem="{Binding ButtonMenu}"/>

                            <TextBlock Grid.Row="6" Grid.Column="2" Text="View" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                            <ComboBox Grid.Row="6" Grid.Column="3" Style="{StaticResource ComboBoxDark}" Margin="0,4,0,4"
                                      ItemsSource="{Binding ViewOptions}" SelectedItem="{Binding ButtonView}"/>

                            <TextBlock Grid.Row="7" Grid.Column="0" Text="DPad ↑" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                            <ComboBox Grid.Row="7" Grid.Column="1" Style="{StaticResource ComboBoxDark}" Margin="0,4,12,4"
                                      ItemsSource="{Binding DPadUpOptions}" SelectedItem="{Binding ButtonDPadUp}"/>

                            <TextBlock Grid.Row="7" Grid.Column="2" Text="DPad ↓" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                            <ComboBox Grid.Row="7" Grid.Column="3" Style="{StaticResource ComboBoxDark}" Margin="0,4,0,4"
                                      ItemsSource="{Binding DPadDownOptions}" SelectedItem="{Binding ButtonDPadDown}"/>

                            <TextBlock Grid.Row="8" Grid.Column="0" Text="DPad ←" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                            <ComboBox Grid.Row="8" Grid.Column="1" Style="{StaticResource ComboBoxDark}" Margin="0,4,12,4"
                                      ItemsSource="{Binding DPadLeftOptions}" SelectedItem="{Binding ButtonDPadLeft}"/>

                            <TextBlock Grid.Row="8" Grid.Column="2" Text="DPad →" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                            <ComboBox Grid.Row="8" Grid.Column="3" Style="{StaticResource ComboBoxDark}" Margin="0,4,0,4"
                                      ItemsSource="{Binding DPadRightOptions}" SelectedItem="{Binding ButtonDPadRight}"/>
                        </Grid>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
