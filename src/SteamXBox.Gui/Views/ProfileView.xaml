<UserControl x:Class="SteamXBox.Gui.Views.ProfileView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:SteamXBox.Gui.ViewModels">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Margin="0,0,16,0">
            <TextBlock Text="Profils" Style="{StaticResource HeaderText}" Margin="0,0,0,12"/>

            <ItemsControl ItemsSource="{Binding Profiles}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border CornerRadius="6" Padding="12,8" Margin="0,0,0,4" Cursor="Hand">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="{StaticResource BgLightBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Name}" Value="Default">
                                            <Setter Property="Background" Value="#FF222233"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Border.InputBindings>
                                <MouseBinding MouseAction="LeftClick"
                                              Command="{Binding DataContext.StartEditingCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                              CommandParameter="{Binding}"/>
                            </Border.InputBindings>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Margin="0,0,6,0"
                                           FontSize="13" Visibility="Collapsed">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="🔒"/>
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Name}" Value="Default">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Grid.Column="1" FontSize="13" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           Text="{Binding Name}"/>
                                <TextBlock Grid.Column="2" Text="{Binding Mode}" FontSize="11"
                                           Foreground="{StaticResource TextDimBrush}"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Separator Background="{StaticResource BorderBrush}" Margin="0,12"/>

            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <TextBox Style="{StaticResource TextBoxDark}" Width="150"
                         Text="{Binding NewProfileName, UpdateSourceTrigger=PropertyChanged}"
                         VerticalContentAlignment="Center"/>
                <Button Content="+" Command="{Binding CreateNewProfileCommand}"
                        Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" Padding="12,8"/>
            </StackPanel>

            <TextBlock Text="{Binding StatusMessage}" FontSize="11"
                       Foreground="{StaticResource AccentOrangeBrush}" Margin="0,4,0,0"
                       TextWrapping="Wrap"/>
        </StackPanel>

        <Border Grid.Column="1" Style="{StaticResource CardBorder}"
                Visibility="{Binding IsEditing, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="Sélectionnez un profil pour l'éditer"
                           Foreground="{StaticResource TextDimBrush}" FontSize="14"
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>

        <Border Grid.Column="1" Style="{StaticResource CardBorder}"
                Visibility="{Binding IsEditingDefault, Converter={StaticResource BoolToVis}}"
                VerticalAlignment="Top">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="Profil par défaut" FontSize="18" FontWeight="Bold"
                           Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center"
                           Margin="0,0,0,8"/>
                <TextBlock Text="Le profil « Default » est le profil d'usine. Il n'est pas modifiable."
                           FontSize="13" Foreground="{StaticResource TextSecondaryBrush}"
                           TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,16"/>
                                <Button Content="🔄  Restaurer les paramètres d'usine" Command="{Binding ResetToFactoryDefaultsCommand}"
                                        Style="{StaticResource SecondaryButton}" Padding="16,8"/>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Column="1"
                      Visibility="{Binding IsEditing, Converter={StaticResource BoolToVis}}"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="4,0,0,0"
                        Visibility="{Binding IsEditingDefault, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}">
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" FontSize="18" FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryBrush}">
                        <Run Text="Édition : "/>
                        <Run Text="{Binding ActiveEdit.Name, Mode=OneWay}" Foreground="{StaticResource AccentBrush}"/>
                    </TextBlock>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Content="Sauvegarder" Command="{Binding SaveProfileCommand}"
                                Style="{StaticResource PrimaryButton}" Margin="0,0,8,0" Padding="16,8"/>
                        <Button Content="Annuler" Command="{Binding CancelEditCommand}"
                                Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Padding="16,8"/>
                        <Button Content="Supprimer" Command="{Binding DeleteActiveProfileCommand}"
                                CommandParameter="{Binding ActiveEdit}"
                                Style="{StaticResource DangerButton}" Padding="16,8"/>
                    </StackPanel>
                </Grid>

                <Border Style="{StaticResource CardBorder}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Paramètres généraux" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,12"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Nom" VerticalAlignment="Center"
                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBox Grid.Row="0" Grid.Column="1" Style="{StaticResource TextBoxDark}"
                                     Text="{Binding ActiveEdit.Name, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,12,4"/>

                            <TextBlock Grid.Row="0" Grid.Column="2" Text="Mode" VerticalAlignment="Center"
                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                            <ComboBox Grid.Row="0" Grid.Column="3" Style="{StaticResource ComboBoxDark}"
                                      SelectedItem="{Binding ActiveEdit.Mode}" Margin="0,4,0,4">
                                <ComboBoxItem Content="Profile"/>
                                <ComboBoxItem Content="Xbox360"/>
                            </ComboBox>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Switch Button" VerticalAlignment="Center"
                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                            <ComboBox Grid.Row="1" Grid.Column="1" Style="{StaticResource ComboBoxDark}"
                                      SelectedItem="{Binding ActiveEdit.SwitchButton}" Margin="0,4,12,4">
                                <ComboBoxItem Content="quick-access"/>
                                <ComboBoxItem Content="steam"/>
                                <ComboBoxItem Content="steam-or-quick-access"/>
                            </ComboBox>

                            <TextBlock Grid.Row="1" Grid.Column="2" Text="Dead Zone" VerticalAlignment="Center"
                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBox Grid.Row="1" Grid.Column="3" Style="{StaticResource TextBoxDark}"
                                     Text="{Binding ActiveEdit.StickDeadZone, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,4"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Sensibilité" VerticalAlignment="Center"
                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBox Grid.Row="2" Grid.Column="1" Style="{StaticResource TextBoxDark}"
                                     Text="{Binding ActiveEdit.RightPadSensitivity, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,12,4"/>

                            <CheckBox Grid.Row="2" Grid.Column="2" Content="Invert Y Left"
                                      IsChecked="{Binding ActiveEdit.LeftPadInvertVertical}"
                                      Style="{StaticResource ToggleSwitch}" Margin="0,4,12,4"/>
                            <StackPanel Grid.Row="2" Grid.Column="3" Orientation="Horizontal">
                                <CheckBox Content="Invert X" IsChecked="{Binding ActiveEdit.RightPadInvertX}"
                                          Style="{StaticResource ToggleSwitch}" Margin="0,4,8,4"/>
                                <CheckBox Content="Invert Y" IsChecked="{Binding ActiveEdit.RightPadInvertY}"
                                          Style="{StaticResource ToggleSwitch}" Margin="0,4,0,4"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardBorder}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Mouvements" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,12"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Pad droit" VerticalAlignment="Center"
                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                            <ComboBox Grid.Row="0" Grid.Column="1" Style="{StaticResource ComboBoxDark}" Margin="0,4,12,4">
                                <ComboBoxItem Content="Trackball"/>
                                <ComboBoxItem Content="Scroll"/>
                                <ComboBoxItem Content="None"/>
                            </ComboBox>

                            <TextBlock Grid.Row="0" Grid.Column="2" Text="Pad gauche" VerticalAlignment="Center"
                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                            <ComboBox Grid.Row="0" Grid.Column="3" Style="{StaticResource ComboBoxDark}" Margin="0,4,0,4">
                                <ComboBoxItem Content="Scroll"/>
                                <ComboBoxItem Content="Trackball"/>
                                <ComboBoxItem Content="None"/>
                            </ComboBox>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock Text="Boutons" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,12"/>

                        <TextBlock Text="Les mappings de boutons sont définis dans le code du ProfileMapper."
                                   FontSize="12" Foreground="{StaticResource TextDimBrush}"
                                   TextWrapping="Wrap"/>
                        <TextBlock Text="Pour les modifier, éditez src/Sc2Xboxed.Core/Mapping/ProfileMapper.cs"
                                   FontSize="11" Foreground="{StaticResource TextDimBrush}"
                                   TextWrapping="Wrap" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
