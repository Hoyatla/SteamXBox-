<Application x:Class="SteamXBox.Gui.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Le theme vit dans SteamXBox.Shell : le GUI et Desktop doivent se ressembler
                     sans que l'un depende de l'autre. -->
                <ResourceDictionary Source="pack://application:,,,/SteamXBox.Shell;component/Themes/DarkTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
