<Window x:Class="SteamXBox.Desktop.Tools.Clipboard.ClipboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:SteamXBox.Shell.Localization;assembly=SteamXBox.Shell"
        xmlns:clip="clr-namespace:SteamXBox.Desktop.Tools.Clipboard"
        Title="Presse-papiers"
        Width="520" Height="620"
        MinWidth="380" MinHeight="400"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" AllowsTransparency="True"
        ResizeMode="CanResizeWithGrip"
        Background="{StaticResource BgDarkBrush}">

    <Window.Resources>
        <clip:NullToCollapsedConverter x:Key="NullToCollapsed"/>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="32"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Background="{StaticResource BgMediumBrush}"
              MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <TextBlock Text="{loc:T Text='Presse-papiers'}" VerticalAlignment="Center"
                       Margin="12,0,0,0" FontSize="12" FontWeight="SemiBold"
                       Foreground="{StaticResource TextSecondaryBrush}"/>
            <Button Content="✕" Click="Close_Click" Width="46" Height="32"
                    HorizontalAlignment="Right" FontSize="13" BorderThickness="0"
                    Background="Transparent" Foreground="{StaticResource TextSecondaryBrush}">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Background" Value="Transparent"/>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource AccentRedBrush}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </Grid>

        <TextBlock Grid.Row="1" Margin="16,12,16,8" FontSize="11" TextWrapping="Wrap"
                   Foreground="{StaticResource TextDimBrush}">
            <TextBlock.Text>
                <loc:T Text="Sélectionnez une entrée pour la coller dans la fenêtre où vous étiez. L'historique n'est pas enregistré sur le disque."/>
            </TextBlock.Text>
        </TextBlock>

        <!-- Chaque entrée est un bouton focusable, comme les tuiles : les flèches parcourent la
             liste et Entrée colle, donc la manette suit le même chemin que le clavier. -->
        <ListBox Grid.Row="2" x:Name="Entries" Margin="10,0,10,0"
                 Background="Transparent" BorderThickness="0"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 HorizontalContentAlignment="Stretch"
                 MouseDoubleClick="Entry_Activated" KeyDown="Entries_KeyDown">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="Margin" Value="0,0,0,6"/>
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="BorderThickness" Value="0"/>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource StatusCard}">
                        <StackPanel>
                            <Image Source="{Binding Image}" MaxHeight="120" Stretch="Uniform"
                                   HorizontalAlignment="Left" Margin="0,0,0,6"
                                   Visibility="{Binding Image, Converter={StaticResource NullToCollapsed}}"/>
                            <TextBlock Text="{Binding Preview}" TextWrapping="Wrap" FontSize="12"
                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBlock Text="{Binding When, StringFormat='{}{0:HH:mm:ss}'}" FontSize="10"
                                       Margin="0,4,0,0" Foreground="{StaticResource TextDimBrush}"/>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <Grid Grid.Row="3" Margin="16,10,16,14">
            <TextBlock x:Name="Status" FontSize="11" VerticalAlignment="Center"
                       Foreground="{StaticResource AccentBrush}" TextWrapping="Wrap"/>
            <Button Style="{StaticResource SecondaryButton}" HorizontalAlignment="Right"
                    Padding="14,6" FontSize="12" Click="Clear_Click"
                    Content="{loc:T Text='Vider'}"/>
        </Grid>
    </Grid>

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="6"
                      GlassFrameThickness="0" CornerRadius="0"/>
    </WindowChrome.WindowChrome>
</Window>
