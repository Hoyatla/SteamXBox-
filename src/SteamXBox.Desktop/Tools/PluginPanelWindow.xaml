<Window x:Class="SteamXBox.Desktop.Tools.PluginPanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Outil" Width="420" SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="{StaticResource BgDarkBrush}">

    <StackPanel Margin="20">
        <TextBlock x:Name="PanelTitle" FontSize="18" Margin="0,0,0,2"
                   Foreground="{StaticResource TextPrimaryBrush}"/>
        <TextBlock x:Name="PanelHint" FontSize="11" Margin="0,0,0,14"
                   Foreground="{StaticResource TextDimBrush}"
                   TextWrapping="Wrap"/>

        <!-- Dessine par l'hote a partir de content. L'outil decrit, il ne dessine pas : c'est ce qui
             rend un outil ecrit par un utilisateur navigable a la manette sans qu'il y ait pense.
             Le dessin lui-meme vit dans PanneauOutil, parce qu'il sert aussi aux onglets de
             l'atelier. -->
        <Border x:Name="Hote"/>
    </StackPanel>
</Window>
