<Window x:Class="SteamXBox.Desktop.Modeles.ModelesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Jeux de modèles" Width="700" Height="640" MinWidth="520" MinHeight="400"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgDarkBrush}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="Jeux de modèles" FontSize="18"
                       Foreground="{StaticResource TextPrimaryBrush}"/>

            <!-- Ce que la carte permet est dit avant la liste, et non après : c'est la première
                 chose qui décide, et l'apprendre après avoir choisi ne sert plus à rien. -->
            <TextBlock x:Name="Carte" FontSize="11" Margin="0,2,0,0" TextWrapping="Wrap"
                       Foreground="{StaticResource TextDimBrush}"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="Liste"/>
        </ScrollViewer>

        <TextBlock x:Name="Etat" Grid.Row="2" Margin="0,12,0,0" FontSize="11"
                   TextWrapping="Wrap"
                   Foreground="{StaticResource TextDimBrush}"/>
    </Grid>
</Window>
