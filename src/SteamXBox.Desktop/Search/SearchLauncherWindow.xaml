<Window x:Class="SteamXBox.Desktop.Search.SearchLauncherWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Recherche"
        Width="720" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True"
        ResizeMode="NoResize" ShowInTaskbar="False"
        Topmost="True" Background="Transparent">

    <!-- Compacte tant que rien n'est cherche, puis elle grandit avec les resultats : c'est
         SizeToContent="Height" plus une liste dont la hauteur suit le nombre de lignes. Une fenetre
         de hauteur fixe montrerait une grande zone vide avant la premiere frappe. -->
    <Border Background="{StaticResource BgDarkBrush}" CornerRadius="10"
            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
        <StackPanel>
            <!-- Rappel discret des lecteurs connectes, au-dessus du champ. Releve a chaque
                 ouverture : une cle branchee entre deux recherches doit apparaitre sans qu'on
                 relance l'environnement. -->
            <ItemsControl x:Name="VolumeStrip" Margin="16,10,16,0">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" Margin="0,0,12,0">
                            <Button Padding="0" Cursor="Hand"
                                    Background="Transparent" BorderThickness="0"
                                    Click="Volume_Click" Tag="{Binding Letter}"
                                    ToolTip="{Binding Letter}">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{Binding Icon}" Stretch="Uniform" Width="12" Height="12"
                                          VerticalAlignment="Center" Margin="0,0,4,0"
                                          Fill="{StaticResource TextDimBrush}"/>
                                    <TextBlock Text="{Binding Label}" FontSize="11"
                                               Foreground="{StaticResource TextDimBrush}"/>
                                </StackPanel>
                            </Button>

                            <!-- Seulement pour ce qui se debranche : un bouton d'ejection a cote du
                                 disque systeme est une offre que personne ne veut voir acceptee. -->
                            <Button Padding="4,0,0,0" Cursor="Hand"
                                    Background="Transparent" BorderThickness="0"
                                    Click="Eject_Click" Tag="{Binding Letter}"
                                    Visibility="{Binding EjectVisibility}"
                                    ToolTip="Éjecter">
                                <Path Data="{Binding EjectIcon}" Stretch="Uniform" Width="12" Height="12"
                                      VerticalAlignment="Center"
                                      Fill="{StaticResource TextDimBrush}"/>
                            </Button>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBox x:Name="Query" FontSize="20" Padding="16,14"
                     Background="Transparent" BorderThickness="0"
                     Foreground="{StaticResource TextPrimaryBrush}"
                     CaretBrush="{StaticResource TextPrimaryBrush}"
                     TextChanged="Query_TextChanged"
                     PreviewKeyDown="Query_PreviewKeyDown"/>

            <Border x:Name="Separator" Height="1" Background="{StaticResource BorderBrush}"
                    Visibility="Collapsed"/>

            <ListBox x:Name="Results" MaxHeight="420" Margin="0,4,0,8"
                     Background="Transparent" BorderThickness="0"
                     Foreground="{StaticResource TextPrimaryBrush}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     Visibility="Collapsed"
                     MouseDoubleClick="Results_Activate">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="8,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="28"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <!-- Le trace vient du fichier, la couleur du theme : les icones sont en
                                 currentColor, donc une seule sert un theme clair et un theme sombre. -->
                            <Path Grid.Column="0" Data="{Binding Icon}" Stretch="Uniform"
                                  Width="18" Height="18" VerticalAlignment="Center"
                                  Fill="{StaticResource TextSecondaryBrush}"/>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{Binding Name}" FontSize="14"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding Detail}" FontSize="11"
                                           Foreground="{StaticResource TextDimBrush}"
                                           TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- L'apercu d'un message. Lecture seule : ouvrir et modifier appartiennent aux outils,
                 pas au lanceur, qui sait trouver et montrer. -->
            <Border x:Name="PreviewPanel" Visibility="Collapsed"
                    BorderThickness="0,1,0,0" BorderBrush="{StaticResource BorderBrush}"
                    Padding="16,10">
                <ScrollViewer x:Name="PreviewScroll" MaxHeight="260"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <TextBlock x:Name="PreviewText" FontSize="12" TextWrapping="Wrap"
                               Foreground="{StaticResource TextSecondaryBrush}"/>
                </ScrollViewer>
            </Border>

            <TextBlock x:Name="Status" Margin="16,0,16,10" FontSize="11"
                       Foreground="{StaticResource TextDimBrush}"/>
        </StackPanel>
    </Border>
</Window>
