<UserControl x:Class="SteamXBox.Desktop.Settings.DebugView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:SteamXBox.Shell.Localization;assembly=SteamXBox.Shell"
             xmlns:views="clr-namespace:SteamXBox.Desktop.Settings">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{loc:T Text='Debug'}" Style="{StaticResource HeaderText}" Margin="0,0,0,20"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="{loc:T Text='Rapport de diagnostic'}" FontSize="16" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,12"/>
                        <TextBlock Text="{loc:T Text='Générez un rapport complet contenant les logs, l\'état des pilotes et les informations système. Utile pour le dépannage.'}"
                                   FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,12"/>

                        <StackPanel Orientation="Horizontal">
                            <Button Content="{loc:T Text='📋  Copier le rapport'}" Command="{Binding CopyDebugReportCommand}"
                                    Style="{StaticResource PrimaryButton}" Margin="0,0,8,0" Padding="16,8"/>
                            <Button Content="{loc:T Text='💾  Sauvegarder le rapport'}" Command="{Binding SaveDebugReportCommand}"
                                    Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Padding="16,8"/>
                            <Button Content="{loc:T Text='📂  Ouvrir le dossier logs'}" Command="{Binding OpenLogFolderCommand}"
                                    Style="{StaticResource SecondaryButton}" Padding="16,8"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="{loc:T Text='Informations système'}" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,12"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="{loc:T Text='Version'}" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding AppVersion}"
                                       Foreground="{StaticResource TextPrimaryBrush}"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="{loc:T Text='OS'}" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding OsVersion}"
                                       Foreground="{StaticResource TextPrimaryBrush}"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="{loc:T Text='.NET Runtime'}" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding DotNetVersion}"
                                       Foreground="{StaticResource TextPrimaryBrush}"/>

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="{loc:T Text='Device'}" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding DeviceName}"
                                       Foreground="{StaticResource TextPrimaryBrush}"/>

                            <TextBlock Grid.Row="4" Grid.Column="0" Text="{loc:T Text='Core'}" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding CoreStatus}"
                                       Foreground="{StaticResource TextPrimaryBrush}"/>

                            <TextBlock Grid.Row="5" Grid.Column="0" Text="{loc:T Text='ViGEmBus'}" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding VigEmStatus}"
                                       Foreground="{StaticResource TextPrimaryBrush}"/>

                            <TextBlock Grid.Row="6" Grid.Column="0" Text="{loc:T Text='HidHide'}" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding HidHideStatus}"
                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock Text="{loc:T Text='Dernières lignes du log'}" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,12"/>
                        <Border Background="{StaticResource CodePanelBrush}" CornerRadius="4" Padding="12,8" MinHeight="200">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <TextBlock Text="{Binding DebugLogTail, Mode=OneWay}"
                                           FontFamily="Consolas" FontSize="11"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           TextWrapping="NoWrap"/>
                            </ScrollViewer>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Ce que Windows expose aux jeux, et non ce que SteamXBox produit. Ajouté après
                     un mode Xbox muet dans un jeu alors que le cœur était sain : une vraie manette
                     Xbox en Bluetooth tenait l'emplacement 0. SteamXBox ne peut pas réattribuer ces
                     emplacements, mais il peut cesser de laisser deviner. -->
                <Border Style="{StaticResource CardBorder}" Margin="0,16,0,0">
                    <StackPanel>
                        <TextBlock Text="{loc:T Text='Manettes concurrentes'}"
                                   Style="{StaticResource HeaderText}" FontSize="15"/>

                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{loc:T Text='Emplacements XInput'}" FontSize="12"
                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock Grid.Column="1" Text="{Binding XinputSlots}" FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                        </Grid>

                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{loc:T Text='Autres manettes'}" FontSize="12"
                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock Grid.Column="1" Text="{Binding RivalControllers}" FontSize="12"
                                       TextWrapping="Wrap"
                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                        </Grid>

                        <TextBlock Text="{Binding ControllerWarning}" FontSize="12" TextWrapping="Wrap"
                                   Margin="0,10,0,0" Foreground="{StaticResource AccentOrangeBrush}"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <TextBlock Grid.Row="2" FontSize="11" Foreground="{StaticResource TextDimBrush}" Margin="0,8,0,0"
                   TextWrapping="Wrap">
            <Run Text="{loc:T Text='Log:'}"/>
            <Run Text="{Binding LogFilePath, Mode=OneWay}"/>
        </TextBlock>
    </Grid>
</UserControl>
