<UserControl x:Class="SteamXBox.Desktop.Settings.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:SteamXBox.Shell.Localization;assembly=SteamXBox.Shell"
             xmlns:vm="clr-namespace:SteamXBox.Desktop.Settings">

    <!-- Les onglets debordent verticalement des que la fenetre est petite. -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                  PanningMode="VerticalOnly">
        <StackPanel>
            <TextBlock Text="{loc:T Text='Paramètres'}" Style="{StaticResource HeaderText}" Margin="0,0,0,20"/>
    
            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="{loc:T Text='Pilotes'}" FontSize="16" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,12"/>
    
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
    
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{loc:T Text='ViGEmBus'}" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBlock Text="{Binding VigEmStatus}" FontSize="12"
                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                        </StackPanel>
                        <Button Grid.Column="1" Content="{loc:T Text='Recharger'}" Command="{Binding CheckDriverStatusCommand}"
                                Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Padding="12,6"/>
                        <Button Grid.Column="2" Content="{loc:T Text='Télécharger'}" Command="{Binding OpenViGEmDownloadCommand}"
                                Style="{StaticResource SecondaryButton}" Padding="12,6"/>
                    </Grid>
    
                    <Separator Background="{StaticResource BorderBrush}" Margin="0,0,0,12"/>
    
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
    
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{loc:T Text='HidHide'}" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBlock Text="{Binding HidHideStatus}" FontSize="12"
                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                        </StackPanel>
                        <Button Grid.Column="1" Content="{loc:T Text='Recharger'}" Command="{Binding CheckDriverStatusCommand}"
                                Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Padding="12,6"/>
                        <Button Grid.Column="2" Content="{loc:T Text='Télécharger'}" Command="{Binding OpenHidHideDownloadCommand}"
                                Style="{StaticResource SecondaryButton}" Padding="12,6"/>
                    </Grid>
                </StackPanel>
            </Border>
    
            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="{loc:T Text='Comportement'}" FontSize="16" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,12"/>
    
                    <CheckBox Content="{loc:T Text='Démarrer avec Windows'}"
                              IsChecked="{Binding StartWithWindows}"
                              Style="{StaticResource ToggleSwitch}"/>
    
                    <TextBlock Text="{Binding StartupStatus}" FontSize="11"
                               Foreground="{StaticResource AccentOrangeBrush}" Margin="0,0,0,4"
                               TextWrapping="Wrap"/>
    
                    <CheckBox Content="{loc:T Text='Démarrer automatiquement à la détection de la manette'}"
                              IsChecked="{Binding AutoStart}"
                              Style="{StaticResource ToggleSwitch}"/>

                    <!-- Extinction de la manette : la combinaison n'est visible nulle part ailleurs,
                         et une fonction que personne ne peut découvrir n'existe pas vraiment. -->
                    <Border Background="#22000000" CornerRadius="4" Padding="10,8" Margin="0,10,0,4">
                        <StackPanel>
                            <TextBlock Text="{loc:T Text='Éteindre la manette'}"
                                       FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"
                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBlock TextWrapping="Wrap" FontSize="11"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       Text="{loc:T Text='Maintenez Menu et View ensemble pendant 3 secondes. SteamXBox débranche la manette virtuelle puis s\'arrête proprement : ce n\'est pas traité comme une déconnexion accidentelle.'}"/>
                            <TextBlock TextWrapping="Wrap" FontSize="11" Margin="0,4,0,0"
                                       Foreground="{StaticResource TextDimBrush}"
                                       Text="{loc:T Text='Les deux boutons doivent être enfoncés en même temps. Relâcher l\'un des deux remet le compte à zéro.'}"/>
                        </StackPanel>
                    </Border>
    
                    <CheckBox Content="{loc:T Text='Minimiser dans la barre des tâches'}"
                              IsChecked="{Binding MinimizeToTray}"
                              Style="{StaticResource ToggleSwitch}"/>

                    <!-- Eteint par defaut : le generateur est le plus gros consommateur du produit,
                         et l'allumer sans qu'on l'ait demande, c'est un processus Python et sa
                         memoire des le demarrage sur une machine qui n'ouvrira peut-etre jamais cet
                         outil de la journee. -->
                    <CheckBox Content="{loc:T Text='Préchauffer le générateur au démarrage'}"
                              IsChecked="{Binding PrechaufferGenerateur}"
                              Margin="0,10,0,0"
                              Style="{StaticResource ToggleSwitch}"/>

                    <TextBlock Margin="0,4,0,0" FontSize="11" TextWrapping="Wrap"
                               Foreground="{StaticResource TextDimBrush}"
                               Text="{loc:T Text='Le premier démarrage du générateur coûte environ deux minutes, les suivants une quinzaine de secondes. Préchauffé, ce temps se paie pendant que vous faites autre chose — au prix d\'un processus et de sa mémoire dès le lancement. Prend effet au prochain démarrage.'}"/>
    
                    <!-- Le thème a rejoint la carte « Thème Windows » : il habille l'environnement
                         et la machine ensemble, sa place n'était plus parmi les préférences. -->

                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="150"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{loc:T Text='Langue'}" FontSize="13"
                                   Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                        <ComboBox Grid.Column="1" Style="{StaticResource ComboBoxDark}"
                                  ItemsSource="{Binding LanguageOptions}"
                                  ItemTemplate="{StaticResource OptionDisplayItem}"
                                  SelectedValuePath="Value"
                                  SelectedValue="{Binding Language}"/>
                    </Grid>
    
                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="150"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{loc:T Text='Intervalle de détection device'}" FontSize="13"
                                   Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                        <!-- Shown in seconds rather than a percentage: unlike a sensitivity, a delay has a
                             unit the user can reason about directly. -->
                        <DockPanel Grid.Column="1">
                            <TextBlock DockPanel.Dock="Right" Style="{StaticResource SliderValueText}"
                                       Text="{Binding DevicePollIntervalDisplay}"/>
                            <Slider Style="{StaticResource SliderCompact}" Minimum="1" Maximum="10"
                                    Value="{Binding DevicePollInterval}"/>
                        </DockPanel>
                    </Grid>
                </StackPanel>
            </Border>
    
            <Border Style="{StaticResource CardBorder}">
                <StackPanel>
                    <TextBlock Text="{loc:T Text='À propos'}" FontSize="16" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,12"/>
                    <TextBlock Text="{Binding AppVersion}" FontSize="14"
                               Foreground="{StaticResource TextPrimaryBrush}"/>
                    <TextBlock Text="{loc:T Text='Steam Controller → Xbox 360 Virtual Gamepad Bridge'}"
                               FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                    <TextBlock Text="{loc:T Text='github.com/Hoyatla/SteamXBox-'}" FontSize="12"
                               Foreground="{StaticResource AccentBrush}" Margin="0,4,0,0"
                               Cursor="Hand">
                        <TextBlock.InputBindings>
                            <MouseBinding MouseAction="LeftClick"
                                          Command="{Binding DataContext.OpenUrlCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                          CommandParameter="https://github.com/Hoyatla/SteamXBox-"/>
                        </TextBlock.InputBindings>
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- Thème Windows. Séparé du thème de l'application : celui-ci modifie la machine, pas
                 seulement les fenêtres de SteamXBox, et cette différence doit se voir. -->
            <Border Style="{StaticResource CardBorder}" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="{loc:T Text='Thème Windows'}" Style="{StaticResource HeaderText}"
                               FontSize="15"/>
                    <!-- Syntaxe d'élément et non entre accolades : le parseur d'extensions de
                         balisage coupe sur les virgules et ne sait pas lire une apostrophe. -->
                    <TextBlock Style="{StaticResource SubHeaderText}" TextWrapping="Wrap" Margin="0,6,0,12">
                        <TextBlock.Text>
                            <loc:T Text="Ces réglages modifient Windows, pas seulement SteamXBox. L'état d'origine est sauvegardé avant la première modification et peut être restauré à tout moment."/>
                        </TextBlock.Text>
                    </TextBlock>

                    <!-- Thème et curseurs présentés à l'identique : même grille, même largeur de
                         liste. Ce sont deux facettes d'un même choix, pas deux mécanismes. -->
                    <Grid Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="190"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{loc:T Text='Thème'}" FontSize="13"
                                   Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                        <ComboBox Grid.Column="1" Style="{StaticResource ComboBoxDark}"
                                  ItemsSource="{Binding Themes}"
                                  SelectedItem="{Binding SelectedTheme}"/>
                    </Grid>

                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="190"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{loc:T Text='Curseurs'}" FontSize="13"
                                   Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                        <ComboBox Grid.Column="1" Style="{StaticResource ComboBoxDark}"
                                  ItemsSource="{Binding CursorPacks}"
                                  SelectedItem="{Binding SelectedCursorPack}"
                                  DisplayMemberPath="Name"/>
                    </Grid>

                    <!-- Auteur, licence et source du paquet choisi. CC BY oblige à créditer et à
                         lier l'original : c'est au produit de le faire, pas à un fichier que
                         personne n'ouvre. -->
                    <TextBlock Text="{Binding CursorAttribution}" FontSize="10" TextWrapping="Wrap"
                               Margin="0,6,0,0" Foreground="{StaticResource TextDimBrush}"/>

                    <TextBlock Text="{Binding ThemeStatus}" FontSize="11" TextWrapping="Wrap"
                               Margin="0,6,0,0" Foreground="{StaticResource TextDimBrush}"/>
                    <TextBlock Text="{Binding WindowsThemeStatus}" FontSize="12" TextWrapping="Wrap"
                               Foreground="{StaticResource AccentBrush}" Margin="0,4,0,0"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                        <Button Style="{StaticResource DangerButton}" Padding="14,8" FontSize="12"
                                Command="{Binding RestoreWindowsThemeCommand}"
                                IsEnabled="{Binding HasWindowsBackup}">
                            <Button.Content>
                                <loc:T Text="Restaurer les réglages Windows d'origine"/>
                            </Button.Content>
                        </Button>
                        <Button Style="{StaticResource PrimaryButton}" Padding="20,8" FontSize="12"
                                Margin="10,0,0,0"
                                Content="{loc:T Text='Appliquer'}"
                                Command="{Binding ApplyWindowsThemeCommand}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
