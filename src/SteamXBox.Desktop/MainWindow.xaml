<Window x:Class="SteamXBox.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:SteamXBox.Shell.Localization;assembly=SteamXBox.Shell"
        Title="SteamXBox Desktop"
        WindowStyle="None" ResizeMode="NoResize"
        ShowInTaskbar="True"
        ShowActivated="False"
        Topmost="False"
        AllowsTransparency="True"
        Background="{x:Null}">

    <!-- Plein ecran fenetre : la fenetre occupe l'ecran mais reste une fenetre ordinaire, elle passe
         derriere les autres et ne s'active jamais d'elle-meme (ShowActivated="False"), donc au
         demarrage la frappe part toujours vers l'application qui etait devant.

         Background="{x:Null}" et non "Transparent", et la difference n'est pas cosmetique : en WPF un
         fond Transparent reste sensible au clic, seul un fond null laisse passer. Avec Transparent,
         la surface maximisee avalait chaque clic tout en ayant l'air d'un bureau vide : impossible
         de cliquer une autre fenetre pour la ramener devant, donc impossible de faire passer
         celle-ci derriere. Avec null, le clic traverse partout sauf sur la carte elle-meme.

         AllowsTransparency reste a True : c'est ce dont le theme a besoin pour son rendu. -->
    <Border x:Name="Card" Style="{StaticResource CardBorder}">
        <StackPanel>
            <!-- Barre de titre : poignee de deplacement du panneau. -->
            <Border Background="{StaticResource BgDarkBrush}" CornerRadius="8,8,0,0"
                    Margin="-16,-16,-16,12" Padding="12,6,6,6"
                    Cursor="SizeAll"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown"
                    MouseMove="TitleBar_MouseMove"
                    MouseLeftButtonUp="TitleBar_MouseLeftButtonUp">
                <DockPanel>
                    <Button Content="✕" Click="Close_Click" DockPanel.Dock="Right" Width="32" Height="28"
                            Margin="8,0,0,0" FontSize="13" Background="Transparent" BorderThickness="0"
                            Foreground="{StaticResource TextSecondaryBrush}">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="Transparent"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="{StaticResource AccentRedBrush}"/>
                                        <Setter Property="Foreground" Value="White"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <TextBlock Text="{Binding VersionText, RelativeSource={RelativeSource AncestorType=Window}}"
                               VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold"
                               Foreground="{StaticResource TextSecondaryBrush}"/>
                </DockPanel>
            </Border>

            <TextBlock Text="{loc:T Text='Centre de contrôle'}" Style="{StaticResource HeaderText}"/>
            <TextBlock Text="{Binding SelectedHint, RelativeSource={RelativeSource AncestorType=Window}}"
                       Style="{StaticResource SubHeaderText}" Margin="0,4,0,0" MinHeight="18"/>

            <ItemsControl x:Name="Tiles" Margin="0,12,0,0"
                          ItemsSource="{Binding Actions, RelativeSource={RelativeSource AncestorType=Window}}"
                          KeyboardNavigation.DirectionalNavigation="Cycle">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="5"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Style="{StaticResource QuickTile}" Click="Tile_Click"
                                GotKeyboardFocus="Tile_Focused" MouseEnter="Tile_Hovered"
                                Tag="{Binding}">
                            <StackPanel>
                                <!-- Deux façons de porter une icône, jamais les deux à la fois : un
                                     glyphe de police pour les outils compilés, une géométrie pour
                                     ceux dont l'icône vient de PluginIcons.xaml. -->
                                <Path Data="{Binding Icon}" Visibility="{Binding IconVisibility}"
                                      Width="28" Height="28" Stretch="Uniform"
                                      HorizontalAlignment="Center"
                                      Fill="{StaticResource AccentBrush}"/>
                                <TextBlock Text="{Binding Glyph}" Visibility="{Binding GlyphVisibility}"
                                           FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                           FontSize="28" HorizontalAlignment="Center"
                                           Foreground="{StaticResource AccentBrush}"/>
                                <!-- Sous l'icône, ce que la tuile a à compter : le nombre
                                     d'événements en cours pour le moniteur d'activité. Absent
                                     partout ailleurs, donc invisible partout ailleurs. -->
                                <TextBlock Text="{Binding Compteur}" Visibility="{Binding CompteurVisibility}"
                                           FontSize="11" Margin="0,4,0,0" TextAlignment="Center"
                                           HorizontalAlignment="Center"
                                           Foreground="{StaticResource AccentBrush}"/>

                                <TextBlock Text="{Binding Label, Converter={StaticResource Loc}}"
                                           FontSize="12" Margin="0,10,0,0" TextAlignment="Center"
                                           TextWrapping="Wrap"
                                           Foreground="{StaticResource TextPrimaryBrush}"/>
                            </StackPanel>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Margin="0,12,0,0" FontSize="11"
                       Foreground="{StaticResource TextDimBrush}"
                       Text="{loc:T Text='Direction pour naviguer, Entrée pour ouvrir.'}"/>
        </StackPanel>
    </Border>
</Window>
