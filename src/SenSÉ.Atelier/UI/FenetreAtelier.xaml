<Window x:Class="SenSÉ.Atelier.UI.FenetreAtelier"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SenSÉ.Atelier.UI"
        Title="Atelier — SenSÉ" Height="800" Width="1280" WindowStartupLocation="CenterScreen">
    <Window.InputBindings>
        <KeyBinding Key="F5" Command="{Binding ExecuterCmd, RelativeSource={RelativeSource AncestorType=Window}}" />
        <KeyBinding Key="Z" Modifiers="Control" Command="{Binding AnnulerCmd, RelativeSource={RelativeSource AncestorType=Window}}" />
        <KeyBinding Key="Y" Modifiers="Control" Command="{Binding RefaireCmd, RelativeSource={RelativeSource AncestorType=Window}}" />
        <KeyBinding Key="Z" Modifiers="Control+Shift" Command="{Binding RefaireCmd, RelativeSource={RelativeSource AncestorType=Window}}" />
        <KeyBinding Key="S" Modifiers="Control" Command="{Binding SauvegarderCmd, RelativeSource={RelativeSource AncestorType=Window}}" />
        <KeyBinding Key="S" Modifiers="Control+Shift" Command="{Binding SauvegarderSousCmd, RelativeSource={RelativeSource AncestorType=Window}}" />
        <KeyBinding Key="N" Modifiers="Control" Command="{Binding NouveauGrapheCmd, RelativeSource={RelativeSource AncestorType=Window}}" />
        <KeyBinding Key="W" Modifiers="Control" Command="{Binding FermerOngletCmd, RelativeSource={RelativeSource AncestorType=Window}}" />
        <KeyBinding Key="Tab" Modifiers="Control" Command="{Binding OngletSuivantCmd, RelativeSource={RelativeSource AncestorType=Window}}" />
        <KeyBinding Key="Tab" Modifiers="Control+Shift" Command="{Binding OngletPrecedentCmd, RelativeSource={RelativeSource AncestorType=Window}}" />
        <KeyBinding Key="F" Modifiers="Control" Command="{Binding FocusPaletteCmd, RelativeSource={RelativeSource AncestorType=Window}}" />
        <KeyBinding Key="F2" Command="{Binding RenommerOngletCmd, RelativeSource={RelativeSource AncestorType=Window}}" />
    </Window.InputBindings>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Barre superieure : espaces -->
        <Border Grid.Row="0" Background="{StaticResource FondPanneauBrush}" Padding="8,4">
            <StackPanel Orientation="Horizontal">
                <Button x:Name="BtnCodage" Content="Codage" Click="BtnCodage_Click" Style="{StaticResource BoutonAccent}" />
                <Button x:Name="BtnMultimedia" Content="Multimédia" Click="BtnMultimedia_Click" />
            </StackPanel>
        </Border>

        <!-- Onglets de graphes -->
        <Border Grid.Row="1" Background="{StaticResource FondPanneauBrush}" BorderBrush="{StaticResource BordureBrush}" BorderThickness="0,1,0,1">
            <StackPanel Orientation="Horizontal" Margin="4,0">
                <ItemsControl x:Name="OngletsGraphes">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="2,4" Padding="0,0" CornerRadius="4,4,0,0"
                                    Background="{Binding Fond, Converter={x:Null}}"
                                    BorderBrush="{StaticResource BordureBrush}" BorderThickness="1"
                                    Tag="{Binding Id}" Cursor="Hand">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="10,4,4,4"
                                                Tag="{Binding Id}"
                                                MouseLeftButtonUp="Onglet_HandleClick">
                                        <TextBlock Text="{Binding Nom}" Foreground="{StaticResource TexteBrush}" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding MarqueurModifie}" Foreground="#F39C12" FontWeight="Bold" FontSize="14" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text=" ×" Margin="6,0,10,0" VerticalAlignment="Center"
                                               Foreground="{StaticResource TexteSecondaireBrush}" Cursor="Hand"
                                               MouseLeftButtonUp="OngletFermer_Click" Tag="{Binding Id}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button x:Name="BtnNouveauGraphe" Content="+" Click="BtnNouveauGraphe_Click" ToolTip="Nouveau graphe (Ctrl+N)" Margin="4,4" />
            </StackPanel>
        </Border>

        <!-- Barre d'actions -->
        <Border Grid.Row="2" Background="{StaticResource FondPanneauBrush}" Padding="8,4" BorderBrush="{StaticResource BordureBrush}" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal">
                <Button x:Name="BtnExecuter" Content="▶ Exécuter (F5)" Click="BtnExecuter_Click" Style="{StaticResource BoutonAccent}" />
                <Button x:Name="BtnSauvegarder" Content="💾 Sauvegarder (Ctrl+S)" Click="BtnSauvegarder_Click" />
                <Separator Margin="8,4" Width="1" Background="{StaticResource BordureBrush}" />
                <Button x:Name="BtnAnnuler" Content="↶ Annuler (Ctrl+Z)" Click="BtnAnnuler_Click" />
                <Button x:Name="BtnRefaire" Content="↷ Refaire (Ctrl+Y)" Click="BtnRefaire_Click" />
                <TextBlock x:Name="Statut" Margin="12,0" VerticalAlignment="Center" Foreground="{StaticResource TexteSecondaireBrush}" />
            </StackPanel>
        </Border>

        <!-- Corps : 3 colonnes -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="280" />
            </Grid.ColumnDefinitions>
            <local:Palette x:Name="PaletteCtl" Grid.Column="0" NoeudChoisi="Palette_NoeudChoisi" />
            <Grid Grid.Column="1">
                <local:CanvasAtelier x:Name="CanvasCtl" SelectionNoeud="CanvasCtl_SelectionNoeud" NoeudDeplace="CanvasCtl_NoeudDeplace" GrapheModifie="CanvasCtl_GrapheModifie" />
                <TextBlock x:Name="CanvasVide" Text="Aucun graphe. Cliquez sur + pour en créer un."
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="{StaticResource TexteSecondaireBrush}" FontSize="16"
                           IsHitTestVisible="False" />
            </Grid>
            <local:Inspecteur x:Name="InspecteurCtl" Grid.Column="2" />
        </Grid>

        <!-- Barre de statut -->
        <Border Grid.Row="4" Background="{StaticResource FondPanneauBrush}" Padding="8,4" BorderBrush="{StaticResource BordureBrush}" BorderThickness="0,1,0,0">
            <TextBlock x:Name="StatutBas" Foreground="{StaticResource TexteSecondaireBrush}" Text="Prêt.  F5=Exécuter, Ctrl+S=Sauver, Ctrl+Z=Annuler, Ctrl+F=Filtrer, F2=Renommer onglet" />
        </Border>
    </Grid>
</Window>
