<UserControl x:Class="SenSÉ.Atelier.UI.SearchBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="BtnSrch" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource TexteBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="6,2" />
            <Setter Property="Margin" Value="2,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="11" />
        </Style>
        <Style x:Key="BtnSrchActif" TargetType="Button" BasedOn="{StaticResource BtnSrch}">
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="Foreground" Value="#1E1E2E" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </UserControl.Resources>
    <Border Background="{StaticResource FondPanneauBrush}"
            BorderBrush="{StaticResource AccentBrush}" BorderThickness="1"
            CornerRadius="4" Padding="6">
        <StackPanel>
            <!-- Ligne 1 : recherche -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <TextBox x:Name="ZoneRecherche" Width="220" KeyDown="ZoneRecherche_KeyDown" />
                    <Button x:Name="BtnModeDesc" Style="{StaticResource BtnSrchActif}" Content="Description" Click="BtnModeDesc_Click" />
                    <Button x:Name="BtnModeCanvas" Style="{StaticResource BtnSrch}" Content="Canvas" Click="BtnModeCanvas_Click" />
                    <CheckBox x:Name="ChkCasse" Content="Aa" Foreground="{StaticResource TexteBrush}"
                              ToolTip="Sensible a la casse" VerticalAlignment="Center" Margin="4,0" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="BtnRechercher" Style="{StaticResource BtnSrch}" Content="Rechercher" Click="BtnRechercher_Click" />
                    <Button x:Name="BtnFermer" Style="{StaticResource BtnSrch}" Content="X" Click="BtnFermer_Click" />
                </StackPanel>
            </Grid>
            <!-- Ligne 2 : remplacement (optionnel) -->
            <Grid Margin="0,4,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <TextBlock Text="Remplacer par :" VerticalAlignment="Center" Margin="0,0,4,0"
                               Foreground="{StaticResource TexteSecondaireBrush}" FontSize="11" />
                    <TextBox x:Name="ZoneRemplacer" Width="220" />
                </StackPanel>
                <Button Grid.Column="1" x:Name="BtnRemplacerTout" Style="{StaticResource BtnSrch}"
                        Content="Remplacer tout" Click="BtnRemplacerTout_Click" />
            </Grid>
            <!-- Ligne 3 : statut -->
            <TextBlock x:Name="Status" FontSize="10" Foreground="{StaticResource TexteSecondaireBrush}" Margin="0,4,0,0" />
        </StackPanel>
    </Border>
</UserControl>
