<Window x:Class="SenSÉ.Atelier.UI.FenetreNoeudCustom"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Noeud custom" Height="600" Width="700" WindowStartupLocation="CenterOwner"
        Background="{StaticResource FondPanneauBrush}">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="120" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Text="Nom" VerticalAlignment="Center" Foreground="{StaticResource TexteBrush}" />
        <TextBox Grid.Row="0" Grid.Column="1" x:Name="TxtNom" Margin="0,2" Background="{StaticResource FondCanvasBrush}" Foreground="{StaticResource TexteBrush}" BorderBrush="{StaticResource BordureBrush}" />

        <TextBlock Grid.Row="1" Grid.Column="0" Text="Description" VerticalAlignment="Center" Foreground="{StaticResource TexteBrush}" />
        <TextBox Grid.Row="1" Grid.Column="1" x:Name="TxtDescription" Margin="0,2" Background="{StaticResource FondCanvasBrush}" Foreground="{StaticResource TexteBrush}" BorderBrush="{StaticResource BordureBrush}" />

        <TextBlock Grid.Row="2" Grid.Column="0" Text="Espace" VerticalAlignment="Center" Foreground="{StaticResource TexteBrush}" />
        <ComboBox Grid.Row="2" Grid.Column="1" x:Name="CmbEspace" Margin="0,2" SelectedIndex="0">
            <ComboBoxItem Content="codage" Tag="codage" />
            <ComboBoxItem Content="multimedia" Tag="multimedia" />
        </ComboBox>

        <TextBlock Grid.Row="3" Grid.Column="0" Text="Langage" VerticalAlignment="Center" Foreground="{StaticResource TexteBrush}" />
        <ComboBox Grid.Row="3" Grid.Column="1" x:Name="CmbLangage" Margin="0,2" SelectedIndex="0">
            <ComboBoxItem Content="python" />
            <ComboBoxItem Content="javascript" />
            <ComboBoxItem Content="powershell" />
            <ComboBoxItem Content="bash" />
        </ComboBox>

        <TextBlock Grid.Row="4" Grid.Column="0" Text="Catégorie" VerticalAlignment="Center" Foreground="{StaticResource TexteBrush}" />
        <TextBox Grid.Row="4" Grid.Column="1" x:Name="TxtCategorie" Text="Perso" Margin="0,2" Background="{StaticResource FondCanvasBrush}" Foreground="{StaticResource TexteBrush}" BorderBrush="{StaticResource BordureBrush}" />

        <TextBlock Grid.Row="5" Grid.Column="0" Text="Code" VerticalAlignment="Top" Foreground="{StaticResource TexteBrush}" Margin="0,6,0,0" />
        <TextBox Grid.Row="5" Grid.Column="1" x:Name="TxtCode" Margin="0,2" AcceptsReturn="True" AcceptsTab="True"
                 TextWrapping="NoWrap" FontFamily="Consolas" FontSize="12"
                 Background="#1A1A2A" Foreground="#E0E0F0" BorderBrush="{StaticResource BordureBrush}"
                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" />

        <TextBlock Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="2"
                   Text="Le code doit definir la variable 'resultat' (sortie) et lire l'entree 'valeur'."
                   Foreground="{StaticResource TexteSecondaireBrush}" FontSize="10" Margin="0,6,0,0" />

        <StackPanel Grid.Row="7" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="BtnAnnuler" Content="Annuler" Click="BtnAnnuler_Click" Margin="0,0,8,0" Padding="16,4" />
            <Button x:Name="BtnCreer" Content="Créer" Click="BtnCreer_Click" Style="{StaticResource BoutonAccent}" Padding="16,4" />
        </StackPanel>
    </Grid>
</Window>