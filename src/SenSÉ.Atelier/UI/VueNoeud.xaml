<UserControl x:Class="SenSÉ.Atelier.UI.VueNoeud"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:SenSÉ.Atelier.UI"
             MinWidth="160" Focusable="True" IsTabStop="True">
    <UserControl.Resources>
        <Style x:Key="BordNorm" TargetType="Border">
            <Setter Property="Background" Value="#2A2A3D" />
            <Setter Property="BorderBrush" Value="#3B3B52" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style x:Key="BordSelected" TargetType="Border" BasedOn="{StaticResource BordNorm}">
            <Setter Property="BorderBrush" Value="#F39C12" />
            <Setter Property="BorderThickness" Value="2" />
        </Style>
        <Style x:Key="BordFocused" TargetType="Border" BasedOn="{StaticResource BordNorm}">
            <Setter Property="BorderBrush" Value="#5DA9FF" />
            <Setter Property="BorderThickness" Value="2" />
        </Style>
        <Style x:Key="BordFocusedSelected" TargetType="Border" BasedOn="{StaticResource BordNorm}">
            <Setter Property="BorderBrush" Value="#F39C12" />
            <Setter Property="BorderThickness" Value="3" />
        </Style>
        <!-- Etats d'execution. Priorite : EnCours > Echec > Reussi > selection/focus. -->
        <Style x:Key="BordEnCours" TargetType="Border" BasedOn="{StaticResource BordNorm}">
            <Setter Property="BorderBrush" Value="#FFD93D" />
            <Setter Property="BorderThickness" Value="3" />
        </Style>
        <Style x:Key="BordReussi" TargetType="Border" BasedOn="{StaticResource BordNorm}">
            <Setter Property="BorderBrush" Value="#7EE787" />
            <Setter Property="BorderThickness" Value="2" />
        </Style>
        <Style x:Key="BordEchec" TargetType="Border" BasedOn="{StaticResource BordNorm}">
            <Setter Property="BorderBrush" Value="#FF6B6B" />
            <Setter Property="BorderThickness" Value="2" />
        </Style>
    </UserControl.Resources>
    <Border x:Name="Bord" CornerRadius="6"
            Background="#2A2A3D" BorderBrush="#3B3B52" BorderThickness="1"
            Padding="0" SnapsToDevicePixels="True"
            GotFocus="Bord_GotFocus" LostFocus="Bord_LostFocus"
            KeyDown="Bord_KeyDown">
        <StackPanel>
            <!-- En-tete -->
            <Border x:Name="Entete" Background="#34344A" CornerRadius="6,6,0,0"
                    Padding="10,6" MouseLeftButtonDown="Entete_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <!-- Label principal en gros : nom vulgarise, tooltip = explication longue. -->
                        <TextBlock x:Name="Titre" Text="Noeud" Foreground="White" FontWeight="SemiBold" FontSize="15"
                                   ToolTip="{Binding DescriptionLongue, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                        <!-- Label technique en petit pour les devs qui veulent l'id. -->
                        <TextBlock x:Name="SousTitre" Text="type" Foreground="#A0A0B8" FontSize="10" FontStyle="Italic" />
                    </StackPanel>
                    <TextBlock x:Name="BadgeStatut" Grid.Column="1" Text="" FontSize="14" FontWeight="Bold"
                               VerticalAlignment="Center" Margin="6,0,0,0" />
                </Grid>
            </Border>
            <!-- Ports entree -->
            <ItemsControl x:Name="ListeEntrees" Margin="0,6,0,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="6,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <local:VuePort Grid.Column="0" />
                            <TextBlock Grid.Column="1" Text="{Binding Nom}" VerticalAlignment="Center" Margin="6,0,0,0" Foreground="#D0D0E0" FontSize="11" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <!-- Ports sortie -->
            <ItemsControl x:Name="ListeSorties" Margin="0,2,0,6">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="6,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding Nom}" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#D0D0E0" FontSize="11" HorizontalAlignment="Right" />
                            <local:VuePort Grid.Column="1" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Border x:Name="ZoneErreur" Background="#3A1F1F" BorderBrush="#FF6B6B"
                    BorderThickness="0,1,0,0" Padding="8,4" Visibility="Collapsed" MaxWidth="240">
                <TextBlock x:Name="TexteErreur" Foreground="#FFB4B4" FontSize="10" TextWrapping="Wrap" />
            </Border>
        </StackPanel>
    </Border>
</UserControl>
