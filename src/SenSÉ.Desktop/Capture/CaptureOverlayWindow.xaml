<Window x:Class="SenSÉ.Desktop.Capture.CaptureOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:SenSÉ.Shell.Localization;assembly=SenSÉ.Shell"
        Title="Capture"
        WindowStyle="None" AllowsTransparency="True" ResizeMode="NoResize"
        ShowInTaskbar="False" Topmost="True"
        Background="#01000000"
        Cursor="Cross">

    <!-- Fond quasi transparent et non totalement : une fenêtre à Background="Transparent" ne reçoit
         pas les clics de souris, et c'est justement d'eux qu'on a besoin ici. Un alpha de 1/255
         suffit à la rendre cliquable tout en restant invisible. -->
    <Canvas x:Name="Surface">
        <!-- Quatre bandes plutôt qu'un voile percé : WPF n'a pas de « trou » dans un rectangle, et
             les découper ainsi évite un masque d'opacité qui coûterait un rendu par déplacement. -->
        <Rectangle x:Name="ShadeTop"    Fill="#88000000"/>
        <Rectangle x:Name="ShadeBottom" Fill="#88000000"/>
        <Rectangle x:Name="ShadeLeft"   Fill="#88000000"/>
        <Rectangle x:Name="ShadeRight"  Fill="#88000000"/>

        <Rectangle x:Name="Selection" Stroke="#4488FF" StrokeThickness="1.5" Visibility="Collapsed"/>

        <Border x:Name="SizeTag" Background="#CC121218" CornerRadius="4" Padding="8,4"
                Visibility="Collapsed">
            <TextBlock x:Name="SizeText" Foreground="White" FontSize="12" FontWeight="SemiBold"/>
        </Border>

        <Border x:Name="Hint" Background="#CC121218" CornerRadius="6" Padding="14,8">
            <TextBlock Foreground="White" FontSize="13"
                       Text="{loc:T Text='Glissez pour sélectionner une zone. Échap pour annuler.'}"/>
        </Border>
    </Canvas>
</Window>
