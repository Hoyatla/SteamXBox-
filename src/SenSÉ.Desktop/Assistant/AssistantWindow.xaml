<Window x:Class="SenSÉ.Desktop.Assistant.AssistantWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Assistant" Width="560" Height="640" MinWidth="420" MinHeight="420"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgDarkBrush}"

        AllowDrop="True"
        PreviewDragOver="SurvolFichier"
        PreviewDrop="DepotFichier">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="Assistant" FontSize="18"
                           Foreground="{StaticResource TextPrimaryBrush}"/>
                <TextBlock x:Name="Presentation" FontSize="11" Margin="0,2,0,0"
                           Foreground="{StaticResource TextDimBrush}"
                           TextWrapping="Wrap"/>
            </StackPanel>

            <Button x:Name="Copier" Grid.Column="1" Content="Copier la conversation"
                    Padding="12,6" VerticalAlignment="Top" Margin="12,0,0,0"
                    Click="CopierClic"/>
        </Grid>

        <!-- Les travaux en cours, au-dessus de la conversation.
             La conversation defile et le plan y disparait ; ici il reste sous les yeux, avec ce qui
             est fait et ce qui attend. C'est aussi le seul endroit ou l'utilisateur donne son
             accord et referme un travail : ces deux decisions sont les siennes, pas celles du
             modele. Toujours visible, meme vide : une zone absente et une zone sans travail se
             ressemblaient trop, et l'utilisateur en a conclu que la fonction n'existait pas. -->
        <Border x:Name="ZoneTravaux" Grid.Row="1"
                Padding="12,10" Margin="0,0,0,12"
                CornerRadius="4"
                Background="{StaticResource BgMediumBrush}"
                VerticalAlignment="Top">
            <StackPanel>
                <TextBlock Text="Travaux en cours" FontSize="12" Margin="0,0,0,6"
                           Foreground="{StaticResource TextSecondaryBrush}"/>
                <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="Travaux"/>
                </ScrollViewer>

                <!-- Donner une tache, et non seulement en lire une.
                     La zone ne montrait que ce que l'assistant s'etait note : rien n'y entrait de
                     l'utilisateur. Or une tache dictee dans la conversation se perd au defilement,
                     et l'assistant la prend pour une demande a satisfaire tout de suite. Ecrite
                     ici, elle reste posee jusqu'a ce qu'elle soit faite. -->
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBox x:Name="Tache" Grid.Column="0"
                             MinHeight="26" Padding="6,4"
                             KeyDown="TacheTouche"
                             TextChanged="TacheChangee"
                             Foreground="{StaticResource TextPrimaryBrush}"
                             CaretBrush="{StaticResource TextPrimaryBrush}"
                             Background="{StaticResource BgDarkBrush}"
                             BorderBrush="{StaticResource BorderBrush}"
                             BorderThickness="1"/>

                    <!-- Le champ vide ne se voyait pas : un rectangle sombre a cote d'un bouton
                         « Ajouter » se lit comme une decoration, et l'utilisateur presse le bouton
                         en attendant qu'il ouvre quelque chose. L'invite dit ou ecrire.
                         IsHitTestVisible=False pour que le clic traverse jusqu'au champ. -->
                    <TextBlock x:Name="Invite" Grid.Column="0"
                               Text="Écrivez ici une chose à faire…"
                               Margin="8,0,0,0" Padding="0,4"
                               VerticalAlignment="Center"
                               IsHitTestVisible="False"
                               Foreground="{StaticResource TextDimBrush}"/>

                    <Button x:Name="Ajouter" Grid.Column="1" Content="Ajouter"
                            Margin="8,0,0,0" Padding="12,4"
                            Click="AjouterClic"/>
                </Grid>

                <TextBlock Text="L'assistant la gardera sous les yeux sans interrompre ce que vous lui demandez."
                           FontSize="10" Margin="0,4,0,0" TextWrapping="Wrap"
                           Foreground="{StaticResource TextDimBrush}"/>
            </StackPanel>
        </Border>

        <!-- Un document, pas une pile de blocs : la conversation se sélectionne d'un bout à
             l'autre et se copie avec Ctrl+C. Des TextBlock empilés étaient plus simples à écrire
             mais impossibles à sélectionner — donc impossibles à transmettre à quelqu'un. -->
        <RichTextBox x:Name="Echanges" Grid.Row="2"
                     IsReadOnly="True" IsDocumentEnabled="True"
                     BorderThickness="0" Background="Transparent"
                     Padding="0"
                     VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Disabled"
                     Foreground="{StaticResource TextSecondaryBrush}"/>

        <!-- Indeterminee, pour la meme raison que dans les autres panneaux : le modele ne dit pas
             ou il en est, et une barre qui avancerait a une vitesse inventee mentirait. -->
        <ProgressBar x:Name="Travail" Grid.Row="3" Height="3" Margin="0,12,0,0"
                     IsIndeterminate="True" Visibility="Collapsed"
                     Background="Transparent" BorderThickness="0"
                     Foreground="{StaticResource AccentBrush}"/>

        <Grid Grid.Row="4" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Ouverte aux fichiers : un chemin se donne en faisant glisser le fichier, pas en le
                 recopiant à la main. C'est la seule valeur qu'un assistant ne peut pas inventer. -->
            <TextBox x:Name="Saisie" Grid.Column="0"
                     MinHeight="56" MaxHeight="120"
                     AcceptsReturn="True" TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     AllowDrop="True"
                     PreviewDragOver="SurvolFichier"
                     PreviewDrop="DepotFichier"
                     Padding="8,6"
                     Foreground="{StaticResource TextPrimaryBrush}"
                     CaretBrush="{StaticResource TextPrimaryBrush}"
                     Background="{StaticResource BgMediumBrush}"
                     BorderBrush="{StaticResource BorderBrush}"
                     BorderThickness="1"/>

            <!-- Envoyer et Arreter occupent la meme place : il n'y a jamais qu'une chose a faire.
                 Deux boutons cote a cote auraient laisse cliquer « Envoyer » pendant que
                 l'assistant travaille, ce qui ne produit rien et se lit comme une panne. -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
                <!-- Le glisser-deposer est impossible et ne le sera plus jamais : le produit exige
                     l'administrateur, WPF recoit les fichiers par OLE, et COM entre deux niveaux
                     d'integrite ne se debloque pas. Mesure : les trois messages Windows sont
                     autorises, l'elevation est vraie, et le depot echoue quand meme. Ce bouton est
                     donc le chemin, pas un pis-aller. -->
                <Button x:Name="Choisir" Content="Fichier…"
                        Margin="10,0,0,0" Padding="12,8"
                        Click="ChoisirClic"/>

                <Button x:Name="ChoisirDossier" Content="Dossier…"
                        Margin="6,0,0,0" Padding="12,8"
                        Click="ChoisirDossierClic"/>

                <!-- Armee, l'assistant ne demande plus quel outil employer : il choisit, et rend
                     compte. Une case et non un bouton, parce que c'est un etat qu'on doit voir
                     durer — savoir que l'assistant agit seul est la moitie de l'accord qu'on lui
                     donne. Le bouton « Fais-le toi-meme » des choix vaut, lui, pour une seule
                     demande. -->
                <CheckBox x:Name="Seul" Content="Faire tout seul"
                          VerticalAlignment="Center" Margin="12,0,0,0"
                          ToolTip="L'assistant choisit les outils lui-même et enchaîne, au lieu de proposer."/>

                <Button x:Name="Envoyer" Content="Envoyer"
                        Margin="8,0,0,0" Padding="16,8"
                        Click="EnvoyerClic"/>

                <Button x:Name="Arreter" Content="Arrêter" Visibility="Collapsed"
                        Margin="10,0,0,0" Padding="16,8"
                        Click="ArreterClic"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
