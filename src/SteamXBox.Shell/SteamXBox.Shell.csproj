<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Ce qui est commun a toutes les fenetres de SteamXBox : le theme, la traduction, le catalogue de
    themes et le centre de controle.

    Cette bibliotheque existe pour que SteamXBox.Desktop ne soit pas oblige de vivre dans le
    processus du pont manette. Le GUI configure la manette ; Desktop est l'environnement. Ce sont
    deux surfaces differentes, avec des cycles de vie differents, et les melanger devient
    ingerable des qu'il y a plus d'un module. Elles partagent leur apparence, pas leur processus.
  -->
  <ItemGroup>
    <ProjectReference Include="..\Sc2Xboxed.Hid\Sc2Xboxed.Hid.csproj" />
    <ProjectReference Include="..\Sc2Xboxed.Core\Sc2Xboxed.Core.csproj" />
    <ProjectReference Include="..\SteamXBox.Plugins\SteamXBox.Plugins.csproj" />
  </ItemGroup>
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <RootNamespace>SteamXBox.Shell</RootNamespace>
    <Product>SteamXBox</Product>
    <AssemblyTitle>SteamXBox Shell</AssemblyTitle>
    <Description>SteamXBox - theme, localisation et centre de controle partages.</Description>
  </PropertyGroup>

</Project>
