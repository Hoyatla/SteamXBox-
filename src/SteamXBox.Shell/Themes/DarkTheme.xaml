<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:loc="clr-namespace:SteamXBox.Gui.Localization"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <loc:LocalizeConverter x:Key="Loc"/>

    <!-- Combo box entries that are profile values: translate the label, keep the stored value. -->
    <DataTemplate x:Key="LocalizedComboItem">
        <TextBlock Text="{Binding Converter={StaticResource Loc}}"/>
    </DataTemplate>

    <!--
        Entries that pair a label with a stored value (typing mode, interface language).

        An explicit template rather than DisplayMemberPath: DisplayMemberPath does not feed
        ComboBox.SelectionBoxItemTemplate, so a retemplated combo box renders the item itself and
        falls back to ToString(). These items are records, whose ToString() prints their field names —
        which is exactly what appeared in the closed combo box under every skin.
    -->
    <DataTemplate x:Key="OptionDisplayItem">
        <TextBlock Text="{Binding Display}"/>
    </DataTemplate>

    <!--
        One row of the Xbox tab's button mapping: the name printed on the controller, then the
        Xbox 360 output it produces. Defined here rather than inline in the view so a skin can
        restyle the mapping panel along with everything else.
    -->
    <DataTemplate x:Key="XboxBindingRow">
        <Grid Margin="0,0,0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="86"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="{Binding Label}" VerticalAlignment="Center"
                       FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
            <ComboBox Grid.Column="1" Style="{DynamicResource ComboBoxDark}"
                      ItemsSource="{Binding DataContext.OutputOptions,
                                    RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                      SelectedItem="{Binding Output}"/>
        </Grid>
    </DataTemplate>

    <Color x:Key="BgDark">#FF121218</Color>
    <Color x:Key="BgMedium">#FF1E1E28</Color>
    <Color x:Key="BgLight">#FF2A2A38</Color>
    <Color x:Key="Accent">#FF4488FF</Color>
    <Color x:Key="AccentGreen">#FF44CC88</Color>
    <Color x:Key="AccentRed">#FFCC4444</Color>
    <Color x:Key="AccentOrange">#FFCC8844</Color>
    <Color x:Key="TextPrimary">#FFE8E8F0</Color>
    <Color x:Key="TextSecondary">#FF888899</Color>
    <Color x:Key="TextDim">#FF555566</Color>
    <Color x:Key="Border">#FF333344</Color>

    <SolidColorBrush x:Key="BgDarkBrush" Color="{StaticResource BgDark}"/>
    <SolidColorBrush x:Key="BgMediumBrush" Color="{StaticResource BgMedium}"/>
    <SolidColorBrush x:Key="BgLightBrush" Color="{StaticResource BgLight}"/>
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource Accent}"/>
    <SolidColorBrush x:Key="AccentGreenBrush" Color="{StaticResource AccentGreen}"/>
    <SolidColorBrush x:Key="AccentRedBrush" Color="{StaticResource AccentRed}"/>
    <SolidColorBrush x:Key="AccentOrangeBrush" Color="{StaticResource AccentOrange}"/>
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimary}"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondary}"/>
    <SolidColorBrush x:Key="TextDimBrush" Color="{StaticResource TextDim}"/>
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource Border}"/>

    <!-- Log and report panels. A theme key rather than a literal in the view: a skin has to be able
         to reach it, otherwise a light skin puts dark text on a near-black panel. -->
    <SolidColorBrush x:Key="CodePanelBrush" Color="#FF0A0A10"/>

    <!-- Discord blurple, the brand's own colour. A key rather than a literal so a skin can tone it
         down, but it should stay recognisable: it is a brand mark, not a decoration. -->
    <SolidColorBrush x:Key="DiscordBrush" Color="#FF5865F2"/>

    <!--
        The Discord mark, drawn as a path rather than shipped as a bitmap: crisp at any size and on
        any DPI, recolourable by a skin, and nothing binary to keep in the repository.
    -->
    <PathGeometry x:Key="DiscordGeometry"
                  Figures="M20.317 4.3698a19.7913 19.7913 0 00-4.8851-1.5152.0741.0741 0 00-.0785.0371c-.211.3753-.4447.8648-.6083 1.2495-1.8447-.2762-3.68-.2762-5.4868 0-.1636-.3933-.4058-.8742-.6177-1.2495a.077.077 0 00-.0785-.037 19.7363 19.7363 0 00-4.8852 1.515.0699.0699 0 00-.0321.0277C.5334 9.0458-.319 13.5799.0992 18.0578a.0824.0824 0 00.0312.0561c2.0528 1.5076 4.0413 2.4228 5.9929 3.0294a.0777.0777 0 00.0842-.0276c.4616-.6304.8731-1.2952 1.226-1.9942a.076.076 0 00-.0416-.1057c-.6528-.2476-1.2743-.5495-1.8722-.8923a.077.077 0 01-.0076-.1277c.1258-.0943.2517-.1923.3718-.2914a.0743.0743 0 01.0776-.0105c3.9278 1.7933 8.18 1.7933 12.0614 0a.0739.0739 0 01.0785.0095c.1202.099.246.198.3728.2924a.077.077 0 01-.0066.1276 12.2986 12.2986 0 01-1.873.8914.0766.0766 0 00-.0407.1067c.3604.698.7719 1.3628 1.225 1.9932a.076.076 0 00.0842.0286c1.961-.6067 3.9495-1.5219 6.0023-3.0294a.077.077 0 00.0313-.0552c.5004-5.177-.8382-9.6739-3.5485-13.6604a.061.061 0 00-.0312-.0286zM8.02 15.3312c-1.1825 0-2.1569-1.0857-2.1569-2.419 0-1.3332.9555-2.4189 2.157-2.4189 1.2108 0 2.1757 1.0952 2.1568 2.419 0 1.3332-.9555 2.4189-2.1569 2.4189zm7.9748 0c-1.1825 0-2.1569-1.0857-2.1569-2.419 0-1.3332.9554-2.4189 2.1569-2.4189 1.2108 0 2.1757 1.0952 2.1568 2.419 0 1.3332-.946 2.4189-2.1568 2.4189z"/>

    <Style x:Key="DiscordButton" TargetType="Button">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="HorizontalAlignment" Value="Right"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border" Background="Transparent" CornerRadius="6" Padding="6,4">
                        <Path x:Name="mark" Data="{StaticResource DiscordGeometry}"
                              Fill="{StaticResource DiscordBrush}"
                              Stretch="Uniform" Width="22" Height="22" Opacity="0.75"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="mark" Property="Opacity" Value="1"/>
                            <Setter TargetName="border" Property="Background" Value="#225865F2"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="mark" Property="Opacity" Value="0.6"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PrimaryButton" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Padding" Value="20,10"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border" Background="{TemplateBinding Background}"
                            CornerRadius="6" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Opacity" Value="0.85"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="border" Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
        <Setter Property="Background" Value="{StaticResource AccentRedBrush}"/>
    </Style>

    <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
        <Setter Property="Background" Value="{StaticResource BgLightBrush}"/>
    </Style>

    <!-- Mouvement des transitions d'onglet. Un skin peut les raccourcir, les allonger, changer
         l'amorti, ou mettre la duree a 0 pour desactiver l'animation. -->
    <Duration x:Key="TabTransitionDuration">0:0:0.13</Duration>
    <sys:Double x:Key="TabTransitionOffset">10</sys:Double>
    <CubicEase x:Key="TabTransitionEase" EasingMode="EaseOut"/>
    <!-- ==================== Shell ====================
         The window frame, exposed as keys so a skin can rework the navigation itself and not just
         its colours. -->

    <Style x:Key="NavRail" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource BgMediumBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="0,0,1,0"/>
    </Style>

    <Style x:Key="StatusCard" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource BgLightBrush}"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="Padding" Value="10,8"/>
    </Style>

    <!-- A RadioButton, so the active tab has a checked state to render. -->
    <Style x:Key="NavButton" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Padding" Value="12,8"/>
        <Setter Property="Margin" Value="0,0,0,4"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="border" Background="{StaticResource BgLightBrush}"
                            CornerRadius="6" Padding="{TemplateBinding Padding}">
                        <ContentPresenter VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Opacity" Value="0.85"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{StaticResource AccentBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="CardBorder" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource BgMediumBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="16"/>
    </Style>

    <Style x:Key="HeaderText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="FontSize" Value="20"/>
        <Setter Property="FontWeight" Value="Bold"/>
    </Style>

    <Style x:Key="SubHeaderText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
        <Setter Property="FontSize" Value="13"/>
    </Style>

    <Style x:Key="TextBoxDark" TargetType="TextBox">
        <Setter Property="Background" Value="{StaticResource BgLightBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="8,6"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="CaretBrush" Value="White"/>
    </Style>

    <Style x:Key="ComboBoxItemDark" TargetType="ComboBoxItem">
        <Setter Property="Background" Value="White"/>
        <Setter Property="Foreground" Value="Black"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Padding" Value="8,6"/>
    </Style>

    <Style TargetType="ComboBoxItem" BasedOn="{StaticResource ComboBoxItemDark}"/>

    <Style x:Key="ComboBoxDark" TargetType="ComboBox">
        <Setter Property="Background" Value="White"/>
        <Setter Property="Foreground" Value="Black"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="8,6"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="ItemContainerStyle" Value="{StaticResource ComboBoxItemDark}"/>
    </Style>

    <Style x:Key="ToggleSwitch" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Margin" Value="0,4"/>
    </Style>

    <Style x:Key="SliderDark" TargetType="Slider">
        <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
        <Setter Property="Background" Value="{StaticResource BgLightBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
        <Setter Property="IsSnapToTickEnabled" Value="True"/>
        <Setter Property="TickFrequency" Value="5"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="0,4"/>
    </Style>

    <!-- Compact variant for the profile editor's narrow columns. -->
    <Style x:Key="SliderCompact" TargetType="Slider" BasedOn="{StaticResource SliderDark}">
        <Setter Property="Minimum" Value="0"/>
        <Setter Property="Maximum" Value="100"/>
        <Setter Property="TickFrequency" Value="1"/>
        <Setter Property="Height" Value="20"/>
        <Setter Property="Margin" Value="0,2,4,2"/>
    </Style>

    <!-- Percentage readout sitting to the right of a compact slider. -->
    <Style x:Key="SliderValueText" TargetType="TextBlock">
        <Setter Property="Width" Value="34"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="TextAlignment" Value="Right"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
    </Style>

</ResourceDictionary>
