    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>DualSenseBench</AssemblyName>
    <RootNamespace>DualSenseBench</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- Volontairement hors de la solution, comme HidProbe : instrument de banc, pas code produit. -->
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Sc2Xboxed.Core\Sc2Xboxed.Core.csproj" />
    <ProjectReference Include="..\..\src\Sc2Xboxed.Windows\Sc2Xboxed.Windows.csproj" />
    <PackageReference Include="HidSharp" Version="2.6.4" />
  </ItemGroup>
</Project>
