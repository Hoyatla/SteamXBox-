<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Un temoin, pas un correctif. Il n'ecrit que son journal et ne touche a rien d'autre.
    Volontairement hors de la solution : c'est un instrument de diagnostic, pas une partie du
    produit, et il ne doit pas grossir les binaires livres.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>SteamXBox-Moniteur</AssemblyName>
    <RootNamespace>SteamXBox.Moniteur</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

</Project>
