<Project>

  <!--
    Signature des executables publies.

    Pourquoi ce fichier existe : Windows n'accorde uiAccess="true" — l'acces aux fenetres elevees
    sans elever le processus — qu'a un binaire signe par un certificat de confiance ET installe dans
    un emplacement sur. Mesure le 11 aout 2026 : sans signature, Windows REFUSE de demarrer le
    processus. Ce n'est donc pas un embellissement, c'est la condition d'une fonctionnalite.

    La signature vaut aussi pour elle-meme sur un produit vendu : un executable non signe declenche
    l'avertissement SmartScreen chez chaque client au premier lancement.

    RIEN NE SE PASSE tant qu'aucun certificat n'est designe. La construction et la publication
    fonctionnent exactement comme avant ; ce fichier ne fait quelque chose que le jour ou l'une des
    deux proprietes ci-dessous est renseignee.

    Deux facons de designer le certificat, au choix :

      1. Par empreinte, le certificat etant dans le magasin Windows — a preferer, aucun mot de passe
         ne traverse la ligne de commande ni les journaux de construction :

           dotnet publish ... -p:SenseSignThumbprint=A1B2C3...

      2. Par fichier .pfx :

           dotnet publish ... -p:SenseSignCertificate=C:\chemin\cert.pfx ^
                              -p:SenseSignPassword=...

    L'horodatage est indispensable et non optionnel : sans lui, les binaires deviennent invalides le
    jour ou le certificat expire, y compris ceux deja installes chez les clients. Avec lui, ils
    restent valides pour toujours.
  -->

  <PropertyGroup>
    <SenseTimestampUrl Condition="'$(SenseTimestampUrl)' == ''">http://timestamp.digicert.com</SenseTimestampUrl>

    <_SenseWantsSigning Condition="'$(SenseSignThumbprint)' != '' or '$(SenseSignCertificate)' != ''">true</_SenseWantsSigning>
  </PropertyGroup>

  <!--
    « Exe » ET « WinExe ». Une application a fenetre — le clavier a l'ecran, l'interface — est
    WinExe, et la premiere version de cette condition ne retenait que Exe : la signature ne s'est
    pas produite, la publication a reussi, et rien ne l'a dit. Le binaire est ressorti NotSigned.
    C'est exactement le defaut que ce projet passe son temps a chasser, commis ici meme.
  -->
  <Target Name="SenseSignPublishedExecutable"
          AfterTargets="Publish"
          Condition="'$(_SenseWantsSigning)' == 'true' and ('$(OutputType)' == 'Exe' or '$(OutputType)' == 'WinExe')">

    <!--
      signtool n'est pas sur le chemin et le SDK .NET ne renseigne pas WindowsSdkVerBinPath, qui
      n'existe que pour les projets C++. Cherche dans le kit Windows, version la plus recente.
    -->
    <ItemGroup Condition="'$(SenseSignToolPath)' == ''">
      <_SenseSignTool Include="$(ProgramFiles)\Windows Kits\10\bin\*\x64\signtool.exe" />
      <_SenseSignTool Include="C:\Program Files (x86)\Windows Kits\10\bin\*\x64\signtool.exe" />
    </ItemGroup>

    <PropertyGroup Condition="'$(SenseSignToolPath)' == ''">
      <SenseSignToolPath>%(_SenseSignTool.FullPath)</SenseSignToolPath>
    </PropertyGroup>

    <!--
      Une signature demandee et impossible arrete la construction. Continuer produirait un binaire
      non signe qui a l'air d'avoir ete signe — et avec uiAccess, Windows le refusera au demarrage
      chez le client, sans que rien ici ne l'ait annonce.
    -->
    <Error Condition="!Exists('$(SenseSignToolPath)')"
           Text="Signature demandee mais signtool.exe est introuvable. Installez le SDK Windows, ou indiquez -p:SenseSignToolPath=..." />

    <PropertyGroup>
      <_SensePublishedExe>$(PublishDir)$(AssemblyName).exe</_SensePublishedExe>

      <_SenseSignArguments Condition="'$(SenseSignThumbprint)' != ''">sign /sha1 $(SenseSignThumbprint) /fd SHA256 /tr $(SenseTimestampUrl) /td SHA256</_SenseSignArguments>
      <_SenseSignArguments Condition="'$(SenseSignThumbprint)' == ''">sign /f "$(SenseSignCertificate)" /p "$(SenseSignPassword)" /fd SHA256 /tr $(SenseTimestampUrl) /td SHA256</_SenseSignArguments>
    </PropertyGroup>

    <Exec Command="&quot;$(SenseSignToolPath)&quot; $(_SenseSignArguments) &quot;$(_SensePublishedExe)&quot;"
          ContinueOnError="false" />

    <!--
      Verifie apres avoir signe, et non pas seulement suppose. La verification est ce qui distingue
      « signtool est sorti sans erreur » de « le fichier porte une signature valide » — deux choses
      que ce projet a appris a ne pas confondre.
    -->
    <Exec Command="&quot;$(SenseSignToolPath)&quot; verify /pa &quot;$(_SensePublishedExe)&quot;"
          ContinueOnError="false" />

    <Message Importance="high" Text="SenSÉ : $(AssemblyName).exe signe et verifie." />
  </Target>

</Project>
