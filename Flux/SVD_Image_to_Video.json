{
  "1": {
    "class_type": "ImageOnlyCheckpointLoader",
    "inputs": {
      "ckpt_name": "svd_xt.safetensors"
    }
  },
  "2": {
    "class_type": "LoadImage",
    "inputs": {
      "image": "example.png"
    }
  },
  "3": {
    "class_type": "ImageScaleToMaxDimension",
    "inputs": {
      "image": ["2", 0],
      "upscale_method": "lanczos",
      "largest_size": 576
    }
  },
  "4": {
    "class_type": "SVD_img2vid_Conditioning",
    "inputs": {
      "clip_vision": ["1", 1],
      "init_image": ["3", 0],
      "vae": ["1", 2],
      "width": 1024,
      "height": 576,
      "video_frames": 14,
      "motion_bucket_id": 127,
      "fps": 6,
      "augmentation_level": 0.0
    }
  },
  "5": {
    "class_type": "VideoLinearCFGGuidance",
    "inputs": {
      "model": ["1", 0],
      "min_cfg": 1.0
    }
  },
  "6": {
    "class_type": "KSampler",
    "inputs": {
      "model": ["5", 0],
      "seed": 42,
      "steps": 20,
      "cfg": 3.0,
      "sampler_name": "euler",
      "scheduler": "beta",
      "positive": ["4", 0],
      "negative": ["4", 1],
      "latent_image": ["4", 2],
      "denoise": 1.0
    }
  },
  "7": {
    "class_type": "VAEDecode",
    "inputs": {
      "samples": ["6", 0],
      "vae": ["1", 2]
    }
  },
  "8": {
    "class_type": "CreateVideo",
    "inputs": {
      "images": ["7", 0],
      "fps": 6.0,
      "bit_depth": 8
    }
  },
  "9": {
    "class_type": "SaveVideo",
    "inputs": {
      "video": ["8", 0],
      "filename_prefix": "svd_output",
      "format": "auto",
      "codec": "auto"
    }
  }
}
