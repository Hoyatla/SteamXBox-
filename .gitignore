# Binaries
SenSÉ.exe
SenSÉ.Core.exe
SenSÉ.Osk.exe
*.bak

# WPF native dependencies
*_cor3.dll
wpfgfx_cor3.dll

# Installer output
SenSÉ_Full_Setup_*.exe
SenSÉ_Setup_*.exe

# ViGEmBus / HidHide installers (re-download at build time)
ViGEmBus_*.exe
HidHide_*.exe

# .NET build artifacts
**/bin/
**/obj/

# tools/ est versionne : make-icon.ps1 et svg-to-png.ps1 font partie du flux de
# fabrication des icones. Leurs bin/ et obj/ restent couverts par les regles plus haut.

# Distribution / temp
dist/
*.zip
*.log
*.pdb

# OS
Thumbs.db
Desktop.ini

# Exclusif skins (keep local)
Library/Exclusif/

# Binaires deployes a la racine : reconstruits par publish, 130 Mo piece.
/SenSÉ.exe
/SenSÉ.Desktop.exe
/SenSÉ.Core.exe
/SenSÉ.Indexer.exe
/SenSÉ-Moniteur.exe
/SenSÉ.Osk.exe
/SenSÉPads.Osk.exe
/SenSÉSticks.Osk.exe
/SenSÉSteam.Osk.exe
/SenSÉPS5.Osk.exe
/SenSÉXbox.Osk.exe
/SenSÉ.Debug.exe
/SenSÉ.Mcp.exe
/Banc-DualSense.exe
/publish/
/artifacts/

# Sauvegardes locales des binaires a la racine
/_backup_*/

# Artefacts d'execution.
*.signal
SenSÉ-*.log*
SenSÉ-diag.txt

# Backups locaux
Library/archive/
/python-manager-26.3.msix

# Outils externes : pres de dix gigaoctets (Python, PyTorch, modeles). Jamais
# dans le depot. Seuls les scripts que nous ecrivons nous-memes y sont versionnes.
/Outils/*
!/Outils/LISEZ-MOI.txt
/python-3.11.0-amd64.exe

# Releves du banc DualSense : une sortie d'outil, reecrite a chaque seance et
# datee. Le depot en portait soixante-cinq fichiers, dont la seule lecture utile
# etait le resume — et le protocole, lui, est ecrit dans docs/.
/mesures/

# Releves du moniteur : un fichier par lancement, nomme a la minute. Vingt-cinq
# d'entre eux, trente-trois megaoctets, s'etaient accumules a la racine avant
# d'avoir un dossier a eux.
/Moniteur/

# Carnets de l'assistant : ce que l'utilisateur et l'assistant local se notent
# pendant une session. Des donnees personnelles, pas du code — et le produit les
# efface lui-meme au bout d'un mois sans ouverture.
/Travaux/

# Binaires SenSÉ (apres rename)
/SenSÉ*.exe
/SenSÉ-*.exe

# Runtime data created by the Assistant (v0.7.2+). NOT source code.
Memoire/
